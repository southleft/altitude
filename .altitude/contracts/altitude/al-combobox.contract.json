      "type": "string",
      "rawType": "string",
      "bindings": {
        "code": {
          "attribute": "fieldId"
        },
        "figma": null
      }
    },
    {
      "name": "fieldNote",
      "description": "The combobox field note",
      "type": "string",
      "rawType": "string",
      "bindings": {
        "code": {
          "attribute": "fieldNote"
        },
