      }
    },
    {
      "name": "filterMode",
      "description": "How `items` is filtered as the user types.\n- **auto** filters `items` client-side by a case-insensitive substring match on `label`\n- **manual** performs no client-side filtering — listen for `onComboboxFilter` and\n  reassign `items` yourself (e.g. after an async request)",
      "type": "enum",
      "rawType": "'auto' | 'manual'",
      "values": [
        "auto",
        "manual"
      ],
      "default": "'auto'",
      "bindings": {
        "code": {
          "attribute": "filterMode"
        },
        "figma": null
      }
