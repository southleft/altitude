      "name": "onComboboxChange",
      "description": "Fired when an option is selected. Detail: `{ value, label, item }`."
    },
    {
      "name": "onComboboxClose",
      "description": "Fired when the listbox closes. Detail: `{ active }` — always `false`."
    },
    {
      "name": "onComboboxFilter",
      "description": "Fired as the input text changes, before filtering is applied. Detail: `{ query }`."
    },
    {
      "name": "onComboboxOpen",
      "description": "Fired when the listbox opens. Detail: `{ active }` — always `true`."
    }
  ],
