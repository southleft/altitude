          "attribute": "isDismissible"
        },
        "figma": null
      }
    },
    {
      "name": "variant",
      "description": "Variant\n- **default** renders a banner that represents an informative announcement\n- **success** renders a banner that represents a success state\n- **warning** renders a banner that represents a warning state\n- **danger** renders a banner that represents a danger/incident state",
      "type": "enum",
      "rawType": "'success' | 'warning' | 'danger'",
