    "element": "div",
    "role": null
  },
  "props": [
    {
      "name": "height",
      "description": "Height property\n- If set, the menu will be constrained to this height in px and enable vertical scrolling",
      "type": "number",
      "rawType": "number",
      "bindings": {
        "code": {
          "attribute": "height"
        },
        "figma": null
      }
    },
    {
      "name": "id",
      "description": "Id attribute\n- Unique id used for A11y\n- Associate the menu with the trigger that controls its open/close state",
      "type": "string",
      "rawType": "string",
      "bindings": {
        "code": {
          "attribute": "id"
        },
        "figma": null
      }
    },
    {
      "name": "indentGroupItems",
      "description": "Indent group items attribute\n**true** - Applies padding to left align the text on group Menu Items with the text of the group Header\n**false** - Does not apply extra padding",
      "type": "boolean",
      "rawType": "boolean",
      "bindings": {
        "code": {
          "attribute": "indentGroupItems"
        },
        "figma": null
      }
    },
    {
      "name": "label",
      "description": "Label attribute\n- Sets ariaLabel for A11y",
      "type": "string",
      "rawType": "string",
      "default": "'Menu'",
      "bindings": {
        "code": {
          "attribute": "label"
        },
        "figma": null
      }
    },
    {
      "name": "variant",
      "description": "Variant\n- **default** Display the menu items with a background and padding\n- **simple** Display the menu items without a background and padding",
      "type": "string",
      "rawType": "'simple'",
      "bindings": {
        "code": {
          "attribute": "variant"
        },
        "figma": {
          "kind": "VARIANT",
          "property": "Variant",
          "options": [
            "Default",
            "Simple"
          ]
        }
      }
    },
    {
      "name": "width",
      "description": "Width property\n- If set, the menu will be constrained to this width in px",
      "type": "number",
      "rawType": "number",
      "bindings": {
        "code": {
          "attribute": "width"
        },
        "figma": null
      }
    }
  ],
  "events": [
    {
      "name": "onMenuItemSelect",
      "description": "Bubbled from `<al-menu-item>` (bubbles + composed). Bind the listener HERE on `<al-menu>`, not on each item. `e.detail.value` carries the selected item's `value` attribute. Example: <al-menu @onMenuItemSelect=${(e) => handleSelect(e.detail.value)}> <al-menu-item value=\"edit\">Edit</al-menu-item> </al-menu>"
    }
  ],
  "slots": [
    {
      "name": "",
      "description": "The menu items in the menu (children must be `<al-menu-item>`)."
    }
  ],
  "states": [
    "hover",
    "focus",
    "active",
    "disabled"
  ],
