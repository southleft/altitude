    },
    {
      "name": "isChecked",
      "description": "Checked attribute\n- If true, sets the treatment to represent an on state\n- If false, sets the treatment to represent an off state\n\nRendered with a PROPERTY binding (`.checked`), not `?checked`, matching\ncheckbox.ts. The content attribute only seeds the initial state: a user\nclick sets the input's dirty-checkedness flag, after which the attribute\nno longer drives `.checked`. Bound as an attribute, setting `isChecked`\nfrom code updated the host class and left the native input alone, so form\nresets and state-driven toggles silently stopped working after one click.",
      "type": "boolean",
      "rawType": "boolean",
      "bindings": {
        "code": {
          "attribute": "isChecked"
        },
        "figma": {
          "kind": "VARIANT",
          "property": "Checked",
          "options": [
            "Off",
            "On"
          ],
          "pairWith": "Checked"
        }
      }
    },
    {
      "name": "isDisabled",
      "description": "Disabled attribute\n- Changes the component's treatment to represent a disabled state",
      "type": "boolean",
      "rawType": "boolean",
      "bindings": {
        "code": {
          "attribute": "isDisabled"
        },
        "figma": {
          "kind": "VARIANT",
          "property": "State",
          "options": [
