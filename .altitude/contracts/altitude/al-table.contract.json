{
  "$schema": "../contract.schema.json",
  "id": "al-table",
  "name": "Table",
  "version": "0.1.0",
  "status": "derived",
  "description": "Component: al-table\n\nRenders a semantic `<table>` either from the `columns` + `data` properties\n(data-driven mode) or from slotted `<thead>` / `<tbody>` markup (slotted\nmode, used when `columns`/`data` are not both set). The horizontal scroll\ncontainer lives INSIDE the component so a wide table scrolls itself —\nthe page never scrolls. Cell/header padding uses the theme's `--al-theme-space-*`\ntokens, so the table is automatically density-aware wherever it is rendered\ninside a `<al-theme density=\"...\">` scope.",
  "semantics": {
    "element": "div",
    "role": null
  },
  "props": [
    {
      "name": "caption",
      "description": "Visible table caption. Also used as the accessible name of the scroll\ncontainer so keyboard users know what they're scrolling.",
      "type": "string",
      "rawType": "string",
      "bindings": {
        "code": {
          "attribute": "caption"
        },
        "figma": null
      }
    },
    {
      "name": "hideCaption",
      "description": "Visually hides the caption while keeping it in the accessibility tree.",
      "type": "boolean",
      "rawType": "boolean",
      "bindings": {
        "code": {
          "attribute": "hideCaption"
        },
        "figma": null
      }
    },
    {
      "name": "isSelectable",
      "description": "Shows a leading checkbox column for row selection.",
      "type": "boolean",
      "rawType": "boolean",
      "bindings": {
        "code": {
          "attribute": "isSelectable"
        },
        "figma": null
      }
    },
    {
      "name": "rowKey",
      "description": "The property on each row object used to derive a stable row identifier\n(used for selection tracking and the `key` attribute).",
      "type": "string",
      "rawType": "string",
      "default": "'id'",
      "bindings": {
        "code": {
          "attribute": "rowKey"
        },
        "figma": null
      }
    },
    {
      "name": "sortDirection",
      "description": "The sort direction of `sortKey`. Mirrors the `aria-sort` vocabulary.",
      "type": "string",
      "rawType": "ALTableSortDirection",
      "default": "'none'",
      "bindings": {
        "code": {
          "attribute": "sortDirection"
        },
        "figma": null
      }
    },
    {
      "name": "sortKey",
      "description": "The `key` of the column currently sorted, if any.",
      "type": "string",
      "rawType": "string",
      "bindings": {
        "code": {
          "attribute": "sortKey"
        },
        "figma": null
      }
    }
  ],
  "events": [
    {
      "name": "onTableRowSelect",
      "description": "Fired when a row's selection checkbox is toggled. Detail: `{ rowKey, isSelected, selectedRowKeys }`."
    },
    {
      "name": "onTableSelectAll",
      "description": "Fired when the header's select-all checkbox is toggled. Detail: `{ isSelected, selectedRowKeys }`."
    },
    {
      "name": "onTableSort",
      "description": "Fired when a sortable header is activated. Detail: `{ key, direction }`. `al-table` does not re-sort `data` itself — it tracks and displays the active sort state (`sortKey`/`sortDirection`, reflected via `aria-sort`); re-render with sorted `data` in response to this event."
    }
  ],
  "slots": [
    {
      "name": "",
      "description": "Slotted `<table>`-internal markup (e.g. `<thead>`/`<tbody>`), used only when `columns` and `data` are not both provided."
    }
  ],
  "states": [
    "hover",
    "focus",
    "active",
    "disabled"
  ],
  "anatomySource": "measured",
  "anatomyCase": "Selectable=no,Sort=ascending",
