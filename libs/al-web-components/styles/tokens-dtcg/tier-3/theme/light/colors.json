      "focus-ring": {
        "comment": "The focus indicator colour. Lives in tier-3 because it is a THEME-level alias of a tier-2 semantic, exactly like header/body background. Before this existed, `al-focus()` read `var(--al-theme-color-focus-ring, var(--al-theme-color-border-primary-default))` against a token the pipeline never emitted, so the fallback always won and no brand or mode could restate the focus colour without editing the mixin.",
        "$value": "{theme.color.border.primary-default}",
        "$type": "color",
        "$extensions": {
          "org.altitude.token": {
            "cssType": "color"
          },
          "org.primer.llm": {
            "usage": "Tier-3 theme-level alias layer. Its one member today, focus-ring, is the brand/mode-restatable focus indicator colour (R4, this session) — consumed by the al-focus()/al-focus-inset() mixins as `outline: <width> solid var(--al-theme-color-focus-ring)`. Legal CSS surface: outline, outline-color, border-color."
          },
          "com.salesforce.styling": {
            "cssProperties": [
              "color",
              "background-color",
              "background",
              "border-color",
              "border",
              "outline-color",
              "outline",
              "box-shadow",
              "fill",
              "stroke",
              "text-decoration-color",
              "caret-color",
              "accent-color",
              "text-stroke",
              "scrollbar-color"
            ]
          },
          "com.atlassian.token": {
            "introduced": "2026-08-23"
          },
          "com.adobe.id": {
            "uuid": "e3a8102b-053f-4d81-83f5-213bcd3d4e80"
          }
        }
      }
    }
