{
  "$description": "<al-theme density=\"compact\">. Tightens the three density-owned spacing roles.",
  "$extensions": {
    "org.altitude.axis": {
      "axis": "density",
      "attribute": "density",
      "mode": "compact",
      "default": false
    }
  },
  "theme": {
    "space": {
      "sm": {
        "$value": "4px",
        "$type": "dimension",
        "$extensions": {
          "org.altitude.token": {
            "cssType": "spacing"
          },
          "org.primer.llm": {
            "usage": "Semantic spacing roles (not a 1:1 alias of the tier-1 space scale — has its own role names). Legal CSS surface: margin, padding, gap."
          },
          "com.salesforce.styling": {
            "cssProperties": [
              "margin",
              "padding",
              "gap",
              "row-gap",
              "column-gap",
              "grid-gap",
              "top",
              "right",
              "bottom",
              "left",
              "inset"
            ]
          },
          "com.adobe.id": {
            "uuid": "931c1184-fa33-4980-98a3-2e54b0f761bc"
          }
        }
      },
