{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://southleft.com/altitude/al-tab.schema.json",
  "title": "ALTab (al-tab)",
  "description": "Component: al-tab\n- **slot**: The tab label",
  "type": "object",
  "altitude": {
    "tagName": "al-tab",
