{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://southleft.com/altitude/al-testimonial.schema.json",
  "title": "ALTestimonial (al-testimonial)",
  "description": "Component: al-testimonial\n\nA single customer quote with attribution — for marketing pages (social\nproof rows, case-study pull-quotes). Composes `<al-avatar>` via the\n`avatar` slot for a headshot.",
  "type": "object",
  "altitude": {
    "tagName": "al-testimonial",
    "className": "ALTestimonial",
    "module": "components/testimonial/testimonial.ts",
    "migration": {
      "state": "scoped-complete",
      "react19": true,
      "headless": false,
      "ssr": false
    },
    "slots": [
      {
        "description": "The quote text.",
        "name": ""
      },
      {
        "description": "Optional avatar (typically an `<al-avatar>`).",
        "name": "avatar"
      }
    ],
    "events": [],
    "cssParts": [],
    "cssProperties": []
  },
  "properties": {
    "tagName": {
      "const": "al-testimonial"
    },
    "attributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "attribution": {
          "description": "The name of the person being quoted.",
          "type": "string"
        },
        "role": {
          "description": "Job title of the person being quoted, e.g. \"VP of Engineering\".",
          "type": "string"
        },
        "company": {
          "description": "Company/organization of the person being quoted.",
          "type": "string"
        }
      }
    },
    "children": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "tagName"
  ]
}
