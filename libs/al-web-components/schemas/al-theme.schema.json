{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://southleft.com/altitude/al-theme.schema.json",
  "title": "ALTheme (al-theme)",
  "description": "Component: al-theme\n- **slot**: The content tree the theme applies to.",
  "type": "object",
  "altitude": {
    "tagName": "al-theme",
    "className": "ALTheme",
    "module": "components/theme/theme.ts",
    "migration": {
      "state": "scoped-complete",
      "react19": true,
      "headless": false,
      "ssr": true
    },
    "slots": [
      {
        "name": "",
        "description": "The content tree the theme applies to."
      }
    ],
    "events": [],
    "cssParts": [],
    "cssProperties": []
  },
  "properties": {
    "tagName": {
      "const": "al-theme"
    },
    "attributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "brand": {
          "description": "Brand identifier. Currently shipped: 'altitude' | 'northright' | 'odyssey' | 'southleft'.",
          "type": "string",
          "enum": [
            "altitude",
            "northright",
            "odyssey",
            "southleft"
          ]
        },
        "mode": {
          "description": "Color mode.",
          "type": "string",
          "enum": [
            "light",
            "dark"
          ]
        },
        "density": {
          "description": "Density axis.",
          "type": "string",
          "enum": [
            "compact",
            "cozy",
            "comfortable"
          ]
        },
        "contrast": {
          "description": "Contrast axis.",
          "type": "string",
          "enum": [
            "normal",
            "more"
          ]
        },
        "motion": {
          "description": "typescript: 'full' | 'reduced' | undefined",
          "type": "string"
        }
      }
    },
    "children": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "tagName"
  ]
}
