{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://southleft.com/altitude/al-icon.schema.json",
  "title": "ALIcon (al-icon)",
  "description": "Component: al-icon-[ICON_NAME]",
  "type": "object",
  "altitude": {
    "tagName": "al-icon",
    "className": "ALIcon",
    "module": "components/icon/icon.ts",
    "migration": {
      "state": "legacy",
      "react19": false,
      "headless": false,
      "ssr": false
    },
    "slots": [],
    "events": [],
    "cssParts": [],
    "cssProperties": []
  },
  "properties": {
    "tagName": {
      "const": "al-icon"
    },
    "attributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "iconTitle": {
          "description": "Icon title",
          "type": "string"
        },
        "size": {
          "description": "Icon size\n- Default size is 16px\n- **xs** renders a smaller size than default (8px)\n- **sm** renders a smaller size than default (12px)\n- **md** renders a larger size than default (20px)\n- **lg** renders a larger size than the md variant (24px)\n- **xl** renders a larger size than the lg variant (32px)\n- **xxl** renders a larger size than the lg variant (36px)\n- **xxxl** renders a larger size than the lg variant (40px)",
          "type": "string",
          "enum": [
            "xs",
            "sm",
            "md",
            "lg",
            "xl",
            "xxl",
            "xxxl"
          ]
        }
      }
    },
    "children": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "tagName"
  ]
}
