{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://southleft.com/altitude/al-card.schema.json",
  "title": "ALCard (al-card)",
  "description": "Component: al-card",
  "type": "object",
  "altitude": {
    "tagName": "al-card",
    "className": "ALCard",
    "module": "components/card/card.ts",
    "migration": {
      "state": "scoped-complete",
      "react19": true,
      "headless": false,
      "ssr": false
    },
    "slots": [
      {
        "description": "The main content of the card (renders below the header).",
        "name": ""
      },
      {
        "description": "Trailing-action row, leading edge (bottom-left). Use for a \"View\" / \"Open\" primary action.",
        "name": "actions-start"
      },
      {
        "description": "Trailing-action row, trailing edge (bottom-right). Use for the canonical bottom-right primary action.",
        "name": "actions-end"
      },
      {
        "description": "Top-right single control (kebab / overflow menu).",
        "name": "action-right"
      },
      {
        "description": "Hero image rendered above the header. Renders flush with the card edge.",
        "name": "image"
      },
      {
        "description": "Card heading row.",
        "name": "header"
      }
    ],
    "events": [],
    "cssParts": [],
    "cssProperties": []
  },
  "properties": {
    "tagName": {
      "const": "al-card"
    },
    "attributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "layout": {
          "description": "typescript: 'inline'",
          "type": "string"
        },
        "variant": {
          "description": "typescript: 'bare'",
          "type": "string"
        }
      }
    },
    "children": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "tagName"
  ]
}
