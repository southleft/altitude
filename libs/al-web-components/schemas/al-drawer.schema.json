{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://southleft.com/altitude/al-drawer.schema.json",
  "title": "ALDrawer (al-drawer)",
  "description": "Component: al-drawer\n- **slot**: The drawer content",
  "type": "object",
  "altitude": {
