{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://southleft.com/altitude/al-pagination-item.schema.json",
  "title": "ALPaginationItem (al-pagination-item)",
  "description": "Component: al-pagination-item\n- **slot**: The pagination item's content",
  "type": "object",
  "altitude": {
    "tagName": "al-pagination-item",
    "className": "ALPaginationItem",
    "module": "components/pagination-item/pagination-item.ts",
