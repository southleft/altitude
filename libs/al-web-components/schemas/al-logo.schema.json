{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://southleft.com/altitude/al-logo.schema.json",
  "title": "ALLogo (al-logo)",
  "description": "Component: al-logo\n- **slot**: The component content",
  "type": "object",
  "altitude": {
    "tagName": "al-logo",
    "className": "ALLogo",
    "module": "components/logo/logo.ts",
    "migration": {
      "state": "scoped-complete",
      "react19": true,
      "headless": false,
      "ssr": false
    },
    "slots": [
      {
        "name": "",
        "description": "The component content"
      }
    ],
    "events": [],
    "cssParts": [],
    "cssProperties": []
  },
  "properties": {
    "tagName": {
      "const": "al-logo"
    },
    "attributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "variant": {
          "description": "The logo variant\n- **default** displays the Altitude logo\n- **northright** displays the Northright logo\n- **odyssey** displays the Odyssey logo\n- **southleft** displays the Southleft logo",
          "type": "string",
          "enum": [
            "northright",
            "odyssey",
            "southleft"
          ]
        },
        "href": {
          "description": "The logo link URL",
          "type": "string"
        }
      }
    },
    "children": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "tagName"
  ]
}
