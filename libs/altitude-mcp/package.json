{
  "name": "@southleft/altitude-mcp",
  "description": "Stdio MCP server exposing Altitude's generated token/component graph (CEM, schemas, tokens, icons, deterministic theme engine) to AI agents",
  "version": "1.0.0",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "altitude-mcp": "./src/server.mjs"
  },
  "scripts": {
    "start": "node --experimental-strip-types --no-warnings ./src/server.mjs",
    "test": "node --experimental-strip-types --no-warnings ./test/smoke.mjs && node --experimental-strip-types --no-warnings ./test/mark-synced.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "author": "Southleft, LLC"
}
