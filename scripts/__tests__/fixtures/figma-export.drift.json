{
  "Primitive": {
    "space": {
      "2": { "$value": "2px", "$type": "dimension" }
    },
    "opacity": {
      "40": { "$value": "0.5", "$type": "number" },
      "87": { "$value": "0.87", "$type": "number" }
    },
    "typography": {
      "font-family": {
        "legacy-editorial": { "$value": "Georgia, Cambria, serif", "$type": "fontFamily" }
      }
    }
  },
  "Color Scheme": {
    "Light": {
      "theme": {
        "color": {
          "background": {
            "default-weak": { "$value": "{color.neutral.light.800}", "$type": "color" }
          }
        }
      }
    },
    "Dark": {
      "theme": {
        "color": {
          "background": {
            "default-weak": { "$value": "{color.neutral.dark.900}", "$type": "color" }
          }
        }
      }
    }
  },
  "Brand": {
    "Altitude": {
      "theme": {
        "color": {
          "background": {
            "primary-default": { "$value": "{Primitive.color.brand.blue.500}", "$type": "color" },
            "primary-strong": { "$value": "{color.brand.red.400}", "$type": "color" }
          }
        }
      }
    },
    "Southleft": {
      "theme": {
        "color": {
          "background": {
            "primary-default": { "$value": "{color.brand.red.500}", "$type": "color" }
          }
        }
      }
    }
  }
}
