{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["files", "patternChoices", "unknowns", "sourceUsed"],
  "additionalProperties": false,
  "properties": {
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "role", "content"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "role": { "type": "string" },
          "content": { "type": "string" }
        }
      }
    },
    "patternChoices": { "type": "array", "items": { "type": "string" } },
    "unknowns": { "type": "array", "items": { "type": "string" } },
    "sourceUsed": { "type": "array", "items": { "type": "string" } }
  }
}
