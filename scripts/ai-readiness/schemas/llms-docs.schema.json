{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["answers", "unanswerable", "urlsFetched", "fetchFailures"],
  "additionalProperties": false,
  "properties": {
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question", "answer", "citedUrl"],
        "additionalProperties": false,
        "properties": {
          "question": { "type": "number" },
          "answer": { "type": "string" },
          "citedUrl": { "type": "string" }
        }
      }
    },
    "unanswerable": { "type": "array", "items": { "type": "string" } },
    "urlsFetched": { "type": "array", "items": { "type": "string" } },
    "fetchFailures": { "type": "array", "items": { "type": "string" } }
  }
}
