{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "One line of .altitude/ai-readiness/history.jsonl (R8) — append-only, one JSON object per line, written by build-scorecard.mjs --append-history. Keyed by harness version (git SHA) + date so a PR diff shows exactly the lines a new run added. Treatment arms are first-class under byTreatment.",
  "required": ["schemaVersion", "date", "generatedAt", "harnessVersion", "runId", "status", "overallReadinessScore", "byTreatment"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "harnessVersion": { "type": "string", "description": "Short git SHA, or \"unknown\"" },
    "runId": { "type": "string" },
    "status": { "type": "string", "enum": ["judged", "unjudged"] },
    "overallReadinessScore": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "byTreatment": {
      "type": "object",
      "description": "treatment ('mcp-off'|'mcp-on'|'with-skill') -> { judgedTaskScores, avgCostUsd, avgLatencyMs, avgGraderScore, avgAxeViolationCount, processAssertionPassRate }",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "judgedTaskScores": {
            "type": "object",
            "additionalProperties": { "type": ["number", "null"], "minimum": 0, "maximum": 100 }
          },
          "avgCostUsd": { "type": ["number", "null"] },
          "avgLatencyMs": { "type": ["number", "null"] },
          "avgGraderScore": { "type": ["number", "null"] },
          "avgAxeViolationCount": { "type": ["number", "null"] },
          "processAssertionPassRate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
