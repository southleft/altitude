{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["violations", "overallSeverity", "sourceUsed"],
  "additionalProperties": false,
  "properties": {
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["what", "why", "fix", "severity", "conventionRef"],
        "additionalProperties": false,
        "properties": {
          "what": { "type": "string" },
          "why": { "type": "string" },
          "fix": { "type": "string" },
          "severity": { "enum": ["low", "medium", "high"] },
          "conventionRef": { "type": "string" }
        }
      }
    },
    "overallSeverity": { "enum": ["low", "medium", "high"] },
    "sourceUsed": { "type": "array", "items": { "type": "string" } }
  }
}
