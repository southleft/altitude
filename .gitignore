# >>> monday-morning:mm >>>
# .mm/ is local-only in git BY DESIGN — team sharing happens via the Monday
# Morning cloud workspace (Settings → Team visibility). Do not force-add past this.
.mm/
# <<< monday-morning:mm <<<
/.claude
.mcp.json

# Secrets. The AI Theme addon (.storybook/ai-theme) reads ANTHROPIC_API_KEY
# from a local .env during `storybook dev`; production reads it from the
# Cloudflare Pages environment. Never commit either.
.env
.env.*
!.env.example
.dev.vars
