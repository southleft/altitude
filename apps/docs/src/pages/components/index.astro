---
/**
 * ROUTE ONLY — the component index of the registry’s DEFAULT project.
 *
 * The body is `src/components/pages/ComponentsIndexPage.astro`, shared with the
 * `src/pages/[project]/` routes. This file exists to bind ONE design-system
 * context to it; it holds no markup and no project name, so a new entry in
 * `.altitude/ds-projects.json` produces a whole site without touching it.
 */
import ComponentsIndexPage from '../../components/pages/ComponentsIndexPage.astro';
import { DEFAULT_CONTEXT } from '../../lib/context.mjs';
---

<ComponentsIndexPage context={DEFAULT_CONTEXT} />
