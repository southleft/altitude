---
/**
 * ROUTE ONLY — the Overview screen of one non-default project.
 *
 * One route per NON-DEFAULT design system in `.altitude/ds-projects.json`
 * (`projectPaths()`), so adding a project to that file adds a whole
 * documentation site and removing it takes one away. The body is
 * `src/components/pages/OverviewPage.astro`, the same file the site at the root renders.
 */
import OverviewPage from '../../components/pages/OverviewPage.astro';
import { projectPaths } from '../../lib/projects.mjs';
import { contextFor } from '../../lib/context.mjs';

export function getStaticPaths() {
  return projectPaths();
}

const { project } = Astro.props;
---

<OverviewPage context={contextFor(project)} />
