---
/**
 * ROUTE ONLY — the migration guide for one non-default project.
 *
 * One route per NON-DEFAULT design system in `.altitude/ds-projects.json`
 * (`projectPaths()`). The guide itself is the shared library's and therefore
 * the same everywhere; what differs is the shell, the brand the examples
 * resolve under, and the component index the page points back into.
 */
import MigrationPage from '../../components/pages/MigrationPage.astro';
import { projectPaths } from '../../lib/projects.mjs';
import { contextFor } from '../../lib/context.mjs';

export function getStaticPaths() {
  return projectPaths();
}

const { project } = Astro.props;
---

<MigrationPage context={contextFor(project)} />
