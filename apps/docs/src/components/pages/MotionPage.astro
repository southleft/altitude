<script>
  /**
   * Every demo on this page is driven by the SHIPPED motion runtime — the same
   * module a consumer imports. Nothing here re-implements a duration, a curve
   * or a preset; the page reads them out of the tokens at the element being
   * animated, which is what makes the axis switcher real rather than a mock.
   */
  import {
    animatePreset,
    createCache,
    isReducedMotion,
    resolveValue,
    run,
  } from '@southleft/al-web-components/motion';

  const scope = document.querySelector<HTMLElement>('[data-motion-scope]');
  const probeRoot = document.querySelector<HTMLElement>('[data-motion-probe]');

  /**
   * The one gate every demo passes through. Delegates to the runtime rather
   * than reading `matchMedia` here, so the answer accounts for the governing
   * `<al-theme>` exactly as it does inside a component.
   */
  const stilled = (el: Element) => isReducedMotion(el, createCache());

  /** Cancel every animation in a subtree so a demo can be replayed from rest. */
  const reset = (root: Element) => {
    for (const el of [root, ...root.querySelectorAll('*')]) {
      for (const animation of el.getAnimations()) animation.cancel();
    }
  };

  const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

  /**
   * Browsers hand back computed custom-property values in their own normalised
   * form — `0.2s` reads as `.2s`. That is the same value, but the tables above
   * print the token's authored spelling, and a readout that disagreed with the
   * table two screens up would read as a bug rather than as a browser detail.
   */
  const spellOut = (value: string) => value.replace(/(^|[^\d])\.(\d)/g, '$10.$2');

  /* ------------------------------------------------------------ axis bar */

  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-axis]'));
  const attrOut = document.querySelector<HTMLElement>('[data-axis-attr]');
  const reducedNote = document.querySelector<HTMLElement>('[data-reduced-note]');
  const probes = Array.from(document.querySelectorAll<HTMLElement>('[data-probe]'));

  const paint = () => {
    if (!scope || !probeRoot) return;
    const value = scope.getAttribute('motion');
    if (attrOut) {
      attrOut.textContent = value ? `<al-theme motion="${value}">` : '<al-theme>';
    }
    // A fresh cache per repaint: a stale one is exactly the bug `resolve.ts`
    // refuses to have, and an attribute flip is the case it names.
    const cache = createCache();
    for (const probe of probes) {
      probe.textContent = spellOut(resolveValue(probe.dataset.probe ?? '', probeRoot, cache)) || '—';
    }
    if (reducedNote) {
      reducedNote.textContent = stilled(probeRoot)
        ? 'REDUCED — DEMOS RESOLVE INSTANTLY'
        : 'FULL MOTION';
    }
  };

  for (const button of buttons) {
    button.addEventListener('click', () => {
      const value = button.dataset.axis;
      // `default` REMOVES the attribute. An unset axis means "no opinion",
      // which is the only state that lets prefers-reduced-motion decide.
      if (!value || value === 'default') scope?.removeAttribute('motion');
      else scope?.setAttribute('motion', value);
      for (const other of buttons) {
        other.setAttribute('aria-pressed', String(other === button));
      }
      paint();
    });
  }

  // `<al-theme>` is a custom element: its `:host` rules only exist once it has
  // upgraded, so the first probe read has to wait for that or it reports the
  // un-themed values.
  customElements.whenDefined('al-theme').then(paint);
  paint();

  try {
    window
      .matchMedia('(prefers-reduced-motion: reduce)')
      .addEventListener('change', paint);
  } catch {
    /* Safari < 14 has no addEventListener on MediaQueryList; the readout just
       will not live-update, which is not worth an error. */
  }

  /* ------------------------------------------------------- tier 1 tracks */

  /** Slide the dot the width of its track and back, over `ms`. */
  const runTrack = (row: Element, ms: number, easing: string, distance?: number) => {
    const track = row.querySelector<HTMLElement>('[data-track]');
    const dot = row.querySelector<HTMLElement>('[data-dot]');
    if (!track || !dot || stilled(dot)) return;
    const travel = distance ?? track.clientWidth - dot.offsetWidth;
    dot.getAnimations().forEach((animation) => animation.cancel());
    dot.animate(
      [{ transform: 'translateX(0px)' }, { transform: `translateX(${Math.max(travel, 0)}px)` }],
      { duration: ms, easing, iterations: 2, direction: 'alternate' }
    );
  };

  document.querySelector('[data-play="duration"]')?.addEventListener('click', () => {
    for (const row of document.querySelectorAll<HTMLElement>('[data-duration-row]')) {
      runTrack(row, Number(row.dataset.ms), 'linear');
    }
  });

  document.querySelector('[data-play="easing"]')?.addEventListener('click', () => {
    for (const card of document.querySelectorAll<HTMLElement>('[data-easing-card]')) {
      runTrack(card, Number(card.dataset.ms), card.dataset.easing ?? 'linear');
    }
  });

  for (const card of document.querySelectorAll<HTMLElement>('[data-easing-card]')) {
    card.addEventListener('click', () =>
      runTrack(card, Number(card.dataset.ms), card.dataset.easing ?? 'linear')
    );
  }

  document.querySelector('[data-play="distance"]')?.addEventListener('click', () => {
    for (const row of document.querySelectorAll<HTMLElement>('[data-distance-row]')) {
      // Travel is the POINT of this demo, so it is the token's px value — not
      // the track width. Duration comes from the theme so the axis still governs it.
      const dot = row.querySelector<HTMLElement>('[data-dot]');
      if (!dot) continue;
      const ms =
        parseFloat(
          resolveValue(
            'var(--al-theme-animation-duration-role-slow, var(--al-theme-animation-duration-long))',
            dot,
            createCache()
          )
        ) * 1000 || 400;
      runTrack(row, ms, 'ease-in-out', Number(row.dataset.px));
    }
  });

  /* ---------------------------------------------------------- css demo */

  const cssDemo = document.querySelector<HTMLElement>('[data-css-demo]');
  document.querySelector('[data-css-toggle]')?.addEventListener('click', () => {
    cssDemo?.classList.toggle('is-on');
  });

  /* ------------------------------------------------------- choreography */

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-replay]')) {
    button.addEventListener('click', async () => {
      const name = button.dataset.replay;
      const card = button.closest('.choreo-card');
      const stage = card?.querySelector<HTMLElement>('[data-stage]');
      if (!name || !stage) return;

      button.disabled = true;
      reset(stage);
      try {
        await run(name, stage);
        // An exit token settles on a hidden end state. Hold it long enough to
        // read, then drop the animations so the card returns to rest and can
        // be replayed — the naming rule is what tells us which those are.
        if (/-(exit|dismiss)$/.test(name)) {
          await wait(500);
          reset(stage);
        }
      } finally {
        button.disabled = false;
      }
    });
  }

  /* -------------------------------------------------------------- presets */

  for (const tile of document.querySelectorAll<HTMLButtonElement>('[data-preset]')) {
    tile.addEventListener('click', async () => {
      const mover = tile.querySelector<HTMLElement>('[data-preset-mover]');
      const name = tile.dataset.preset;
      if (!mover || !name) return;
      mover.getAnimations().forEach((animation) => animation.cancel());
      await animatePreset(mover, name);
      // Every preset is filled `both`, so an exit shape would leave the tile
      // blank. Settle, hold, then release back to rest — uniformly, rather
      // than maintaining a list of which names are exits.
      await wait(500);
      mover.getAnimations().forEach((animation) => animation.cancel());
    });
  }
</script>
