---
/**
 * Overview (Home) — the canvas's `data-screen-label="Home"` screen, rendered
 * for ONE design system.
 *
 * The canvas typed "68 COMPONENTS" and "21 / 28 / 19 COMPONENTS" into its
 * markup. Here every one of those numbers is read from the SCOPED registry on
 * the context, so the hero, the stat bar and the atomic cards restate whichever
 * design system's library this site documents rather than a snapshot of one.
 *
 * The page body lives in this component rather than in a route file because
 * there are now N routes producing it — `/` for the registry's default project
 * and `/<id>` for every other. Same body, different context; no forked
 * template, which is the whole point of the multi-project engine.
 */
import Shell from '../../layouts/Shell.astro';
import Logo from '../Logo.astro';
import { A11Y_REPORT } from '../../lib/a11y.mjs';
import { PARITY_STATUS, totalsForProject } from '../../lib/parity.mjs';
import { brandOverrides } from '../../lib/tokens.mjs';
import { SITE } from '../../lib/site.mjs';
import { DEFAULT_CONTEXT } from '../../lib/context.mjs';
import { COMPONENT_COUNT } from '../../lib/registry.mjs';

interface Props {
  context: any;
}

const { context } = Astro.props;
const { project, registry, site, href } = context;

const TIER_COPY = {
  atoms: 'Indivisible primitives — buttons, inputs, badges, icons. Each maps to one token contract.',
  molecules: 'Atoms bonded into function — search fields, alerts, cards, selects, toasts.',
  organisms: 'Full sections of interface — headers, footers, layout and theme hosts.',
};

const stats = [
  { value: registry.count, label: 'COMPONENTS' },
  { value: 3, label: 'TOKEN TIERS' },
  { value: 2, label: 'THEMES' },
  { value: registry.stats.icons, label: 'ICON GLYPHS' },
];

const parityTotals = totalsForProject(project);
const overrides = brandOverrides(project.brand);
---

<Shell context={context} title={site.name} active="overview">
  <div class="topbar">
    <span>{site.fullName.toUpperCase()}</span>
    <span class="micro--blue"
      >{registry.count} COMPONENTS — 2 THEMES — 3 TOKEN TIERS</span
    >
    <span>BY {SITE.vendor}</span>
  </div>

  <div class="hero blueprint">
    <span class="blueprint__tick blueprint__tick--tl">+</span>
    <span class="blueprint__tick blueprint__tick--tr">+</span>
    <span class="blueprint__tick blueprint__tick--bl">+</span>
    <span class="blueprint__tick blueprint__tick--br">+</span>
    <div>
      <div class="micro--lg">/// DOCUMENTATION SITE</div>
      <h1 class="t-display-lg">
        Design at {site.name.toLowerCase()}<span style="color:var(--blue)">.</span>
      </h1>
      <p class="t-body-lg hero__lede">
        {registry.count} production components, three tiers of design tokens, light and dark themes.
        Built on Lit web components with React wrappers, organized by atomic design.
      </p>
      <div class="hero__actions">
        <a class="btn" href={href('/components')}>Browse components</a>
        <a class="btn btn--outline" href={href('/foundations')}>Foundations</a>
      </div>
    </div>
    <div class="hero__plate-wrap">
      <div class="hero__plate">
        <span class="hero__plate-label hero__plate-label--tl">BRAND / {project.brand.toUpperCase()}</span>
        <span class="hero__plate-label hero__plate-label--br">ACCENT: THEME-CONTENT-PRIMARY</span>
        <Logo project={project} variant="mark" style="width:60%;max-width:220px;display:block;margin:0 auto" />
        <div class="hero__measure">
          <span></span>
          <span class="micro">&lt;al-theme brand="{project.brand}"&gt;</span>
          <span></span>
        </div>
      </div>
    </div>
  </div>

  <div class="statbar">
    {
      stats.map((stat) => (
        <div class="statbar__cell">
          <div class="statbar__value">{stat.value}</div>
          <div class="micro" style="margin-top:10px">
            {stat.label}
          </div>
        </div>
      ))
    }
  </div>

  <!--
    SCOPE — only on a design system that declares one. A scoped system documents
    a SUBSET of the shared library, and saying so is the difference between "21
    components" meaning "this is a small system" and meaning "this is the part
    of a 68-component library that this product ships". The allowlist lives in
    .altitude/ds-projects.json and is gated by scripts/check-sl-scope.mjs.
  -->
  {
    registry.scope.scoped && (
      <div class="stack-56">
        <div class="micro--lg" style="margin-bottom:14px">/// SCOPE</div>
        <h2 class="t-display-md" style="margin-bottom:12px; max-width:640px">
          {registry.count} of {COMPONENT_COUNT}.
        </h2>
        <p class="t-body-md" style="margin:0; max-width:640px; color:var(--fg-weak)">
          {site.fullName} is built on the same component library as{' '}
          <a href={DEFAULT_CONTEXT.href('/')}>{DEFAULT_CONTEXT.site.fullName}</a>, and documents the{' '}
          {registry.count} components it actually ships. The list is declared in the design-system
          registry and re-derived from this brand's own site source by a CI gate, so a component
          earns a page here by being used — not by being available.
        </p>
      </div>
    )
  }

  <div class="stack-56">
    <div class="micro--lg" style="margin-bottom:14px">/// ATOMIC BY DESIGN</div>
    <h2 class="t-display-md" style="margin-bottom:36px; max-width:640px">
      Atoms make molecules. Molecules make organisms.
    </h2>
    <div class="tier-cards">
      {
        registry.tiers.map((tier, i) => (
          <a class="hard-card" href={`${href('/components')}#${tier.id}`}>
            <div class="tier-cards__head">
              <span class="micro">{String(i + 1).padStart(2, '0')}</span>
              <span class="micro micro--blue">{tier.count} COMPONENTS</span>
            </div>
            <div class="tier-cards__glyph" data-tier={tier.id} />
            <div class="t-heading-sm">{tier.label.charAt(0) + tier.label.slice(1).toLowerCase()}</div>
            <p class="t-body-sm" style="margin:6px 0 0">
              {TIER_COPY[tier.id]}
            </p>
          </a>
        ))
      }
    </div>
  </div>

  <!--
    SYSTEM STATUS — the site-wide roll-up of the same two artifacts the
    per-component panels read (this project's Figma parity manifest, and
    .altitude/a11y/report.json). Deliberately placed on the overview rather
    than buried: a design system's honest claim about itself is a headline
    fact, and stating it once at the top is what stops the per-component
    panels reading as isolated warnings.
  -->
  <div class="stack-56">
    <div class="micro--lg" style="margin-bottom:14px">/// SYSTEM STATUS</div>
    <h2 class="t-display-md" style="margin-bottom:12px; max-width:640px">
      Measured, not asserted.
    </h2>
    <p class="t-body-md" style="margin:0 0 36px; max-width:640px; color:var(--fg-weak)">
      Every number below is generated at build time from the artifact that produced it — the Figma
      parity manifests and an axe-core run over the component library's stories. Where something has
      not been measured, this says so instead of leaving it blank.
    </p>

    <div class="status-grid">
      {
        parityTotals.map((total) => (
          <div class="hard-card status-card">
            <div class="tier-cards__head">
              <span class="micro">FIGMA PARITY</span>
              <span class="micro micro--blue">{total.projectName.toUpperCase()}</span>
            </div>
            <dl class="status-card__rows">
              {Object.entries(total.counts)
                .sort((a, b) => b[1] - a[1])
                .map(([status, count]) => (
                  <div>
                    <dt>{PARITY_STATUS[status].label}</dt>
                    <dd>{count}</dd>
                  </div>
                ))}
            </dl>
            <p class="status-card__foot">
              {
                /* Three genuinely different states, and "0 of 0 observed" is
                   the one that most easily reads as fine. A file with no
                   component sets mapped at all has not been checked against
                   anything — say that, rather than reporting a ratio whose
                   denominator is zero. */
                !total.observation.everObserved
                  ? `The Figma side of "${total.figmaFileName}" has never been read, so drift originating in Figma cannot be reported at all.`
                  : total.observation.mappedComponents === 0
                    ? `"${total.figmaFileName}" was read on ${total.observation.figmaLastRefreshed.slice(0, 10)} and contains no component sets for this system, so every component below is reported against nothing. These are build-it-in-Figma counts, not drift.`
                    : `${total.observation.observedComponents} of ${total.observation.mappedComponents} mapped Figma sets observed, last read ${total.observation.figmaLastRefreshed.slice(0, 10)}.`
              }
            </p>
          </div>
        ))
      }

      <div class="hard-card status-card">
        <div class="tier-cards__head">
          <span class="micro">BRAND</span>
          <span class="micro micro--blue">{project.brand.toUpperCase()}</span>
        </div>
        <dl class="status-card__rows">
          <div>
            <dt>TOKEN PROPERTIES REDECLARED</dt>
            <dd data-brand-overrides={overrides.properties.length}>{overrides.properties.length}</dd>
          </div>
          <div>
            <dt>SCOPED BLOCKS</dt>
            <dd>{[...new Set(overrides.properties.flatMap((p) => p.blocks))].join(' · ') || '—'}</dd>
          </div>
        </dl>
        <p class="status-card__foot">
          {
            overrides.reason ??
              `Applied by <al-theme brand="${project.brand}"> on :host, composing over the base token bundle rather than replacing it. Everything not listed resolves to the shared value.`
          }
        </p>
      </div>

      <div class="hard-card status-card">
        <div class="tier-cards__head">
          <span class="micro">ACCESSIBILITY</span>
          <span class="micro micro--blue">
            {A11Y_REPORT.available ? `AXE ${A11Y_REPORT.source.axeVersion}` : 'NOT MEASURED'}
          </span>
        </div>
        {
          A11Y_REPORT.available ? (
            <>
              <dl class="status-card__rows">
                <div>
                  <dt>CLEAN COMPONENTS</dt>
                  <dd>
                    {A11Y_REPORT.totals.componentsClean}/{A11Y_REPORT.totals.componentsMeasured}
                  </dd>
                </div>
                <div>
                  <dt>STORIES CHECKED</dt>
                  <dd>{A11Y_REPORT.totals.stories}</dd>
                </div>
                <div>
                  <dt>STRUCTURAL RULES FAILING</dt>
                  <dd>{A11Y_REPORT.totals.structuralViolations}</dd>
                </div>
                <div>
                  <dt>CONTRAST RULES FAILING</dt>
                  <dd>{A11Y_REPORT.totals.contrastViolations}</dd>
                </div>
                <div>
                  <dt>STORIES UNMEASURED</dt>
                  <dd>{A11Y_REPORT.totals.storiesErrored}</dd>
                </div>
              </dl>
              <p class="status-card__foot">
                {A11Y_REPORT.source.axeTags.join(' + ')} on {A11Y_REPORT.generated.slice(0, 10)}. The
                CI gate excludes <code>{A11Y_REPORT.source.gateExcludes.join(', ')}</code>; this run
                does not. Measured on the library's own stories, under the reference brand — not
                per brand.
              </p>
            </>
          ) : (
            <p class="status-card__foot">{A11Y_REPORT.reason}</p>
          )
        }
      </div>
    </div>
  </div>

  <div class="split">
    <a class="split__cell" href={href('/foundations')}>
      <div class="micro">01 — FOUNDATIONS</div>
      <div class="split__swatches">
        <span style="background:var(--blue)"></span>
        <span style="background:var(--blue-hover)"></span>
        <span style="background:var(--blue-soft)"></span>
        <span style="background:var(--fg)"></span>
        <span style="border:1px solid var(--line)"></span>
        <span class="split__aa">Aa</span>
      </div>
      <div class="t-heading-sm">Color, type, space, elevation <span style="color:var(--blue)">→</span></div>
    </a>
    <div class="split__cell split__cell--static">
      <div class="micro">GET STARTED</div>
      <pre class="code code--inline" style="margin:20px 0"><span style="color:var(--blue-hover)">$</span> pnpm add {site.npmPackage}</pre>
      <div class="t-heading-sm">Ship it in Lit, React, or plain HTML</div>
    </div>
  </div>

  <div class="site-foot">
    <span>© 2026 {SITE.vendor} LLC</span>
    <span>TOKENS IN DTCG · STYLE DICTIONARY V5</span>
    {
      project.isDefault ? (
        <a href={SITE.storybook} target="_blank" rel="noopener" style="letter-spacing:.12em">
          STORYBOOK ↗
        </a>
      ) : (
        <a href={DEFAULT_CONTEXT.href('/')} style="letter-spacing:.12em">
          {DEFAULT_CONTEXT.site.name.toUpperCase()} →
        </a>
      )
    }
  </div>
</Shell>

<style>
  .status-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
  }

  .status-card {
    display: flex;
    flex-direction: column;
  }

  .status-card__rows {
    margin: 22px 0 0;
    display: grid;
    gap: 0;
  }

  .status-card__rows > div {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    padding: 9px 0;
    border-top: 1px solid var(--line-weak);
  }

  .status-card__rows dt {
    font: 500 9px/1.4 var(--mono);
    letter-spacing: 0.12em;
    color: var(--fg-weak);
  }

  .status-card__rows dd {
    margin: 0;
    font: 500 15px/1 var(--mono);
  }

  .status-card__foot {
    margin: 18px 0 0;
    font: 400 12px/19px var(--sans);
    color: var(--fg-weak);
  }

  .status-card__foot code {
    font: 400 11px/1 var(--mono);
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: 56px;
    padding: 72px 64px;
    border-bottom: 1px solid var(--line);
  }

  .hero__lede {
    margin: 24px 0 0;
    max-width: 520px;
  }

  .hero__actions {
    display: flex;
    gap: 12px;
    margin-top: 32px;
    flex-wrap: wrap;
  }

  .hero__plate-wrap {
    display: flex;
    align-items: center;
  }

  .hero__plate {
    position: relative;
    width: 100%;
    border: 1px dashed var(--al-border);
    background: var(--bg);
    box-shadow: 10px 10px 0 var(--blue);
    padding: 56px 40px;
  }

  .hero__plate-label {
    position: absolute;
    font: 400 9px/1 var(--mono);
    letter-spacing: 0.14em;
    color: var(--fg-weak);
  }

  .hero__plate-label--tl {
    top: 10px;
    left: 12px;
  }

  .hero__plate-label--br {
    bottom: 10px;
    right: 12px;
  }

  .hero__measure {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 32px;
  }

  .hero__measure > span:first-child,
  .hero__measure > span:last-child {
    flex: 1;
    border-top: 1px solid var(--fg);
  }

  .tier-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
  }

  .tier-cards__head {
    display: flex;
    justify-content: space-between;
  }

  .tier-cards__glyph {
    height: 88px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .tier-cards__glyph::before {
    content: '';
    width: 16px;
    height: 16px;
    background: var(--blue);
    display: block;
  }

  .tier-cards__glyph[data-tier='molecules']::after,
  .tier-cards__glyph[data-tier='organisms']::after {
    content: '';
    width: 16px;
    height: 16px;
    border: 1.5px solid var(--fg);
    display: block;
  }

  .tier-cards__glyph[data-tier='organisms']::before {
    box-shadow:
      24px 0 0 var(--fg),
      -24px 0 0 var(--blue);
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    border-bottom: 1px solid var(--line);
  }

  .split__cell {
    padding: 36px 40px;
    color: inherit;
    display: block;
    transition: background 0.15s;
  }

  .split__cell:hover {
    background: var(--bg2);
    color: inherit;
  }

  .split__cell--static {
    border-left: 1px solid var(--line-weak);
  }

  .split__cell--static:hover {
    background: transparent;
  }

  .split__swatches {
    display: flex;
    gap: 4px;
    margin: 20px 0;
    align-items: center;
  }

  .split__swatches > span {
    width: 26px;
    height: 26px;
  }

  .split__aa {
    font: 700 26px/1 var(--sans);
    margin-left: 12px;
    width: auto !important;
    height: auto !important;
  }

  @media (max-width: 1100px) {
    .hero,
    .split {
      grid-template-columns: 1fr;
    }

    .tier-cards {
      grid-template-columns: 1fr;
    }

    .hero {
      padding: 40px 20px;
    }

    .split__cell--static {
      border-left: none;
      border-top: 1px solid var(--line-weak);
    }
  }
</style>
