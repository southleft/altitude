---
/**
 * Maturity — the sixth INDEX screen, rendered for ONE design system.
 *
 * The site could already answer "what is this component's lifecycle phase?" —
 * one component at a time, as a chip on its own page, plus a sidebar link that
 * filters the index. What it could not answer is the question anyone planning
 * work actually asks: what is the SHAPE of the library right now. Which phases
 * exist and how full they are, what the v2 migration still has open, and how
 * many components have no measured accessibility result at all.
 *
 * That answer already existed, scattered across four artifacts nobody reads
 * side by side, so this page joins them rather than restating them — see the
 * header of `src/lib/maturity.mjs` for which artifact owns which column, and
 * why the join key is not the slug alone. The columns themselves, including
 * how many there are, come from `.altitude/migration.schema.json`: a fourth
 * capability tracked there becomes a fourth column here with no edit to this
 * file.
 *
 * WHY A `—` IS NOT A `no`. Three of the columns are tri-state, and the third
 * state is the one that matters: a component the manifest does not track has no
 * answer, and rendering a negative for it would invent a measurement. Every
 * unanswered row is also listed underneath with the reason it has no answer,
 * for the same reason the checks panels state an absent axe report instead of
 * omitting the panel.
 */
import Shell from '../../layouts/Shell.astro';
import {
  MANIFEST_PATH,
  MIGRATION_CAPABILITIES,
  MIGRATION_MANIFEST,
  MIGRATION_STATES,
  SCHEMA_PATH,
  maturityRows,
  maturitySummary,
} from '../../lib/maturity.mjs';

interface Props {
  context: any;
}

const { context } = Astro.props;
const { registry, site, href } = context;

const rows = maturityRows(context);
const summary = maturitySummary(context);
const unanswered = rows.filter((row: any) => !row.tracked);

/** ATOMS → Atom, for the tier column; the label is the registry's, not a map. */
const tierLabel = new Map<string, string>(
  registry.tiers.map((tier: any) => [tier.id, tier.label.toLowerCase()]),
);

/**
 * Which tone a lifecycle phase renders in. Deliberately only two rules and a
 * default: `deprecated` is the one phase that is a warning to a reader, and
 * `undeclared` is the one that is an absence. Everything else — stable, beta,
 * whatever a future story declares — is just a phase, and inventing a colour
 * per name here would put a vocabulary in the stylesheet that the library owns.
 */
const phaseTone = (status: string | null) =>
  status === 'deprecated' ? 'status--deprecated' : status ? 'status--beta' : '';

/** `true → ●`, `false → ○`, `null → —`. The glyph is repeated in the label. */
const FLAG = { true: '●', false: '○', null: '—' } as const;
const flagOf = (value: boolean | null) => FLAG[String(value) as keyof typeof FLAG];
const flagWord = (value: boolean | null) => (value === null ? 'no answer' : value ? 'yes' : 'no');
---

<Shell
  context={context}
  title="Maturity"
  description={`Every ${site.fullName} component against its lifecycle phase, its v2 migration state and its measured accessibility position.`}
  active="maturity"
>
  <div class="page">
    <div class="micro">INDEX / 06</div>
    <h1 class="t-page-title">Maturity</h1>
    <p class="t-body-md mat-lede">
      One view of where all {summary.total} components stand. Nothing on this page is maintained
      here: the phases come from the registry, the migration columns from
      <code class="mono">{MANIFEST_PATH}</code> with their vocabulary read from
      <code class="mono">{SCHEMA_PATH}</code>, and the accessibility column from the same axe report
      each component's own checks panel reads.
    </p>
    <p class="t-body-md mat-lede">
      A <strong>—</strong> is not a <em>no</em>. It means the row has no answer, and every row with
      one is listed at the foot of the page with the reason.
    </p>

    <div class="section-rule">
      <span>LIFECYCLE — {summary.lifecycle.length} PHASES</span>
      <span>DECLARED BY EACH COMPONENT'S OWN STORY</span>
    </div>
    <!-- ARRANGEMENT IS <al-layout> (R4); the wrapper owns the margin a
         display:contents host cannot carry. .mat-phase stays CSS flex —
         card internals, not section arrangement. -->
    <div class="mat-phases-wrap">
      <al-layout direction="row" wrap class="mat-phases">
        {
          summary.lifecycle.map((phase: any) => (
            <a class="mat-phase" href={href(`/components?status=${phase.id}`)}>
              <span class="mat-phase__count">{phase.count}</span>
              <span class="micro">{phase.label}</span>
            </a>
          ))
        }
      </al-layout>
    </div>

    <div class="section-rule">
      <span>V2 MIGRATION</span>
      <span>{summary.tracked} OF {summary.total} TRACKED</span>
    </div>
    {
      MIGRATION_MANIFEST.available ? (
        <div class="spec-table spec-table--props">
          <div class="spec-table__head">
            <span>STATE</span>
            <span>MEANS</span>
            <span>COUNT</span>
          </div>
          {MIGRATION_STATES.map((state: any) => (
            <div class="spec-table__row">
              <span class="spec-table__name">{state.id}</span>
              <span class="spec-table__type">{state.note ?? '—'}</span>
              <span class="spec-table__default">{summary.states.find((s: any) => s.id === state.id)?.count ?? 0}</span>
            </div>
          ))}
          {summary.capabilities.map((capability: any) => (
            <div class="spec-table__row">
              <span class="spec-table__name">{capability.id}</span>
              <span class="spec-table__type">{capability.note ?? '—'}</span>
              <span class="spec-table__default">
                {capability.count} / {capability.of}
              </span>
            </div>
          ))}
        </div>
      ) : (
        <p class="empty-note">{MIGRATION_MANIFEST.reason}</p>
      )
    }
    {
      summary.deprecateAliasesBy && (
        <p class="t-body-sm mat-foot">
          The compat budget in <code class="mono">{MANIFEST_PATH}</code> allows the legacy aliases —
          v1 token names and tag suffixes — to be removed in{' '}
          <strong>{summary.deprecateAliasesBy}</strong>. Until then both spellings resolve; after it,
          only the v2 one does.
        </p>
      )
    }

    <div class="section-rule">
      <span>ACCESSIBILITY</span>
      <span>
        {summary.a11y.measured} MEASURED · {summary.a11y.clean} CLEAN · {summary.a11y.open} OPEN
      </span>
    </div>
    <p class="t-body-md mat-lede">
      <em>Measured</em> means axe ran against this component; <em>clean</em> means it ran and found
      nothing. Neither is a certification — the screen-reader and keyboard rows on each component's
      page need a human, and a row nobody has recorded is counted as unrecorded here rather than as
      a pass.
    </p>

    <div class="section-rule">
      <span>THE MATRIX — {summary.total} COMPONENTS</span>
      <span>● YES · ○ NO · — NO ANSWER</span>
    </div>
    <div class="mat-table" style={`--mat-flags: ${MIGRATION_CAPABILITIES.length}`}>
      <div class="mat-table__head">
        <span>COMPONENT</span>
        <span>TIER</span>
        <span>LIFECYCLE</span>
        <span>MIGRATION</span>
        {MIGRATION_CAPABILITIES.map((capability: any) => (
          <span title={capability.note ?? undefined}>{capability.id}</span>
        ))}
        <span>A11Y</span>
      </div>
      {
        rows.map((row: any) => (
          <div class="mat-table__row">
            <a class="mat-table__name" href={href(`/components/${row.slug}`)}>
              {row.name}
              <span class="mat-table__tag">{row.tag}</span>
            </a>
            <span class="mat-table__cell">{tierLabel.get(row.tier) ?? row.tier}</span>
            <span class="mat-table__cell">
              <span class={`status ${phaseTone(row.status)}`}>{row.status ?? 'undeclared'}</span>
            </span>
            <span class="mat-table__cell">{row.state ?? '—'}{row.expiry ? ` → ${row.expiry}` : ''}</span>
            {MIGRATION_CAPABILITIES.map((capability: any) => (
              <span
                class={`mat-table__cell mat-flag${row.capabilities[capability.id] === true ? ' is-yes' : ''}`}
              >
                <span aria-hidden="true">{flagOf(row.capabilities[capability.id])}</span>
                <span class="al-u-is-vishidden">
                  {capability.id}: {flagWord(row.capabilities[capability.id])}
                </span>
              </span>
            ))}
            <span class="mat-table__cell">
              {row.a11y.measured
                ? row.a11y.open
                  ? `${row.a11y.open} open`
                  : `clean${row.a11y.unrecorded ? ` · ${row.a11y.unrecorded} unrecorded` : ''}`
                : 'not measured'}
            </span>
          </div>
        ))
      }
    </div>

    {
      unanswered.length > 0 && (
        <>
          <div class="section-rule">
            <span>ROWS WITH NO MIGRATION ANSWER — {unanswered.length}</span>
            <span>WHY, RATHER THAN A BLANK</span>
          </div>
          <div class="spec-table spec-table--pair">
            <div class="spec-table__head">
              <span>COMPONENT</span>
              <span>WHY</span>
            </div>
            {unanswered.map((row: any) => (
              <div class="spec-table__row">
                <span class="spec-table__name">{row.tag}</span>
                <span class="spec-table__type">{row.untrackedReason}</span>
              </div>
            ))}
          </div>
        </>
      )
    }

    {
      summary.manifestOnly.length > 0 && (
        <p class="t-body-sm mat-foot">
          {MANIFEST_PATH} also tracks {summary.manifestOnly.length} component
          {summary.manifestOnly.length === 1 ? '' : 's'} this design system does not document. It
          documents a declared subset of the shared library, so that is the normal case rather than a
          gap.
        </p>
      )
    }
  </div>
</Shell>

<style>
  .mat-lede {
    margin: 0 0 24px;
    max-width: 640px;
  }

  .mat-foot {
    margin: 12px 0 8px;
    color: var(--fg-weak);
    max-width: 640px;
  }

  /* The wrapper owns the margin; 2px is off al-layout's gap scale. */
  .mat-phases-wrap {
    margin-bottom: 44px;
  }

  .mat-phases {
    --al-layout-gap: 2px;
  }

  .mat-phase {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px 20px;
    border: 1px solid var(--line-weak);
    min-width: 128px;
    color: inherit;
    text-decoration: none;
  }

  .mat-phase:hover {
    border-color: var(--blue);
  }

  .mat-phase__count {
    font: 600 28px/1 var(--sans);
    letter-spacing: -0.02em;
  }

  /*
   * The matrix is a grid and not a <table> for the same reason `.spec-table` is:
   * the rest of this site's tabular surfaces are grids, and mixing the two
   * gives two different sets of rules to keep aligned. The flag columns are
   * counted into the track list from `--mat-flags`, so a capability added to
   * the manifest schema widens the grid without a stylesheet edit.
   */
  .mat-table {
    border-top: 1px solid var(--line);
    margin-bottom: 40px;
    overflow-x: auto;
  }

  .mat-table__head,
  .mat-table__row {
    display: grid;
    grid-template-columns:
      minmax(180px, 2fr) 92px 110px 132px
      repeat(var(--mat-flags), 68px) minmax(130px, 1fr);
    gap: 12px;
    align-items: center;
    padding: 10px 0;
    border-bottom: 1px solid var(--line-weak);
    min-width: 900px;
  }

  .mat-table__head {
    font: 500 9px/1 var(--mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-weak);
    padding: 12px 0;
  }

  .mat-table__name {
    display: flex;
    flex-direction: column;
    gap: 3px;
    font: 500 13px/1.3 var(--sans);
    color: inherit;
    text-decoration: none;
  }

  .mat-table__name:hover {
    color: var(--blue);
  }

  .mat-table__tag {
    font: 400 10px/1 var(--mono);
    color: var(--fg-weak);
  }

  .mat-table__cell {
    font: 400 11px/1.4 var(--mono);
    color: var(--fg-weak);
  }

  /*
   * The glyph carries no meaning on its own, so every flag cell also emits the
   * capability name and the word — `react19: yes` — for anyone not reading the
   * column header three rows up, screen reader or not.
   */
  .mat-flag {
    font-size: 13px;
    color: var(--line);
    text-align: center;
  }

  .mat-flag.is-yes {
    color: var(--blue);
  }
</style>
