---
/**
 * The app shell from the design canvas: a fixed 264px sidebar beside a
 * single scrolling `<main>`. Every page of every design system's site renders
 * inside it — one shell, one design language, N brands.
 *
 * TWO THEMING AXES, deliberately separate:
 *
 *   `data-theme` on <html> — the docs CHROME's light/dark, driven by the
 *   sidebar's pill switch, the same mechanism the canvas uses. It styles the
 *   documentation, not the thing being documented.
 *
 *   `<al-theme brand mode>` around the whole shell — the COMPONENTS' brand.
 *   Tokens land on `:host` and inherit into the light DOM inside it
 *   (`.altitude/BRANDS.md`; the mechanism `pnpm test:scoped-theming` proves),
 *   so every live preview on a project's site renders in that project's brand
 *   with no forked template and no second stylesheet. It composes on top of
 *   `dist/css/main.css` rather than replacing it, which is why the neutral
 *   reference brand emits no override block at all and still works.
 *
 * The one place the two meet is the accent: `docs.css` re-declares `--blue`
 * ON the `al-theme` element as `var(--al-theme-color-content-primary-default)`.
 * Declared there and not on `:root`, so it resolves against the BRANDED value
 * rather than the base one — custom properties substitute where they are
 * declared, so a `:root` declaration would have frozen the base blue before the
 * brand could reach it.
 */
import '@southleft/al-web-components/css/main.css';
import '../styles/docs.css';
import Sidebar from '../components/Sidebar.astro';
import BrandTheme from '../components/BrandTheme.astro';
import LiveRuntime from '../components/LiveRuntime.astro';
import BrandRuntime from '../components/BrandRuntime.astro';
import { SITE, base } from '../lib/site.mjs';

interface Props {
  /** The design-system context this page belongs to (lib/context.mjs). */
  context: any;
  title: string;
  description?: string;
  active?: 'overview' | 'foundations' | 'components';
  activeSlug?: string;
  /** Load the component runtime (only detail pages render live elements). */
  liveComponents?: boolean;
}

const {
  context,
  title,
  description = context.site.description,
  active,
  activeSlug,
  liveComponents = false,
} = Astro.props;

const { project, site } = context;
const pageTitle = title === site.name ? site.title : `${title} · ${site.name}`;
const canonical = new URL(Astro.url.pathname, SITE.url).toString();
---

<!doctype html>
<html
  lang="en"
  data-docs-base={base}
  data-docs-project={project.id}
  data-docs-brand={project.brand}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.fullName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />

    <!-- Restore the saved theme before first paint. -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('al-docs-theme');
          if (stored === 'dark' || stored === 'light') {
            document.documentElement.dataset.theme = stored;
          }
        } catch (e) {
          /* localStorage unavailable — light (the :root default) stands. */
        }
      })();
    </script>

    {
      /* Deep component imports self-register only when this flag is set at
         module-eval time (.altitude/REGISTRATION.md — load-bearing, not a boot
         convenience). Inline, in <head>, before any component module. Set on
         every page now, not only the live ones: `<al-theme>` wraps the shell. */
    }
    <script is:inline>window.alAutoRegistry = true;</script>
  </head>
  <body>
    <al-theme brand={project.brand} data-brand-host>
      <div class="shell">
        <Sidebar context={context} active={active} activeSlug={activeSlug} />
        <main class="shell__main" id="main">
          <slot />
        </main>
      </div>
    </al-theme>

    <script>
      // Theme switch. Reflects into `data-theme` on <html> for the docs chrome
      // and into `mode` on <al-theme> for the components, so one control moves
      // both axes together instead of leaving branded previews in light mode on
      // a dark page.
      const label = document.querySelector<HTMLElement>('[data-theme-label]');
      const host = document.querySelector<HTMLElement>('[data-brand-host]');
      const paint = () => {
        const mode = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
        if (label) label.textContent = mode.toUpperCase();
        host?.setAttribute('mode', mode);
      };
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem('al-docs-theme', next);
        } catch (e) {
          /* ignore */
        }
        paint();
      });
      paint();
    </script>

    <BrandTheme />
    <!--
      THE BRAND LAYER GOES FIRST, AND THE ORDER IS LOAD-BEARING.

      A brand layer may OVERRIDE a base component: same tag, brand
      implementation (`supersedes` in .altitude/ds-projects.json — Southleft's
      `al-header` and `al-footer`). `customElements.define` is first-come,
      first-served and cannot be undone, so whichever bundle evaluates first
      owns the tag for the life of the page. LiveRuntime imports the WHOLE base
      library; if it ran first it would claim `al-header` and the brand
      implementation this page exists to document would silently never upgrade.

      Registered in this order, the base bundle finds the tag taken and skips
      it — which is exactly the override the registry declares. Module scripts
      execute in document order, so this is ordering, not a race.

      Only pages of a project that HAS a layer render this at all.
    -->
    {liveComponents && context.registry.layer && <BrandRuntime />}
    {liveComponents && <LiveRuntime />}
  </body>
</html>
