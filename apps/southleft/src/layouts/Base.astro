---
// Base layout — spec 2026-08-20-southleft-example-app, T1/T3.
//
// Mirrors southleft-v5's Base.astro contract (`theme` prop: 'dark' default |
// 'light'), rebuilt on the Altitude Astro fixture pattern (apps/astro):
// alAutoRegistry inline in <head>, @southleft/al-web-components/css/main.css imported
// once, deep component imports as a bundled <script> at the end of <body>.
/*
 * The design system's own token bundle, replacing `css/main.css`'s base
 * palette. One file per system, `:root` for the default mode and
 * `[data-al-mode='…']` for the other — the shape the Figma file uses, where a
 * file IS a system and one collection carries both modes.
 *
 * `main.css` still supplies the reset, the cascade layers, the base element
 * styles and the utility classes; it is the PALETTE that moves here. Nothing
 * sets `brand` any more: this page renders Southleft because it loaded
 * Southleft's tokens, not because an attribute selected them.
 */
import '@southleft/al-web-components/css/main.css';
import '@southleft/al-web-components/project/southleft.css';
import '../styles/fonts.css';
import '../styles/layout.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../lib/site';
import { MEDIA_BASE, LOCAL_MEDIA_BASE, LOCAL_MEDIA_ACTIVE } from '../lib/media.mjs';

interface Props {
  title: string;
  description?: string;
  /** Marketing pages = dark ("ink"). Article/case-study/legal pages = light
   * ("paper"), matching v5. */
  theme?: 'dark' | 'light';
  ogImage?: string;
  /** JSON-LD graph node(s) — Organization sitewide, BlogPosting on articles. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description = SITE.description, theme = 'dark', ogImage, jsonLd } = Astro.props;

const pageTitle = title === SITE.name ? SITE.title : `${title} · ${SITE.name}`;
const canonical = new URL(Astro.url.pathname, SITE.url).toString();
const resolvedOgImage = ogImage ? new URL(ogImage, SITE.url).toString() : undefined;

// Organization JSON-LD is sitewide (T4-1 requirement); page-specific nodes
// (BlogPosting, CreativeWork) are appended alongside it, not in place of it.
const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.url,
  email: SITE.email,
  sameAs: [SITE.linkedin, SITE.github, SITE.substack],
};
const ldNodes = [organizationLd, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {resolvedOgImage && <meta property="og:image" content={resolvedOgImage} />}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — Insights`} href={`${SITE.url}/rss.xml`} />

    {ldNodes.map((node) => <script type="application/ld+json" set:html={JSON.stringify(node)} />)}

    <!-- Opt the deep component imports into self-registration. Must run
         (inline) before the bundled module script below. -->
    <script is:inline>window.alAutoRegistry = true;</script>
  </head>
  <body>
    {LOCAL_MEDIA_ACTIVE && import.meta.env.DEV && (
      <script is:inline define:vars={{ MEDIA_BASE, LOCAL_MEDIA_BASE }}>
        // T11 — local media for dev. `resolveMedia()` (media.mjs) already
        // localizes every content-collection `hero` field at render time;
        // this covers the one thing it CAN'T reach — `<img>`s embedded
        // directly in the migrated markdown BODIES (raw WordPress-export
        // HTML a rehype pass can't walk, see media.mjs's header comment).
        // Those bodies still carry the real, resolved MEDIA_BASE (remote)
        // URL on disk; this rewrites them to the local path our own
        // `vite-plugin-local-media.mjs` middleware serves, so the
        // Cloudflare-Access-gated remote host is never hit in dev. Most of
        // these carry `loading="lazy"` (the WordPress export markup did),
        // so a MutationObserver that fires as soon as each element is
        // inserted — well before an offscreen lazy image's real fetch
        // begins — corrects the src before the browser ever requests it.
        (function () {
          function localize(root) {
            root.querySelectorAll('img[src^="' + MEDIA_BASE + '"]').forEach((img) => {
              img.src = LOCAL_MEDIA_BASE + img.src.slice(MEDIA_BASE.length);
            });
          }
          localize(document);
          new MutationObserver((mutations) => {
            for (const m of mutations) {
              for (const node of m.addedNodes) {
                if (!(node instanceof Element)) continue;
                if (node.matches && node.matches('img[src^="' + MEDIA_BASE + '"]')) {
                  node.src = LOCAL_MEDIA_BASE + node.src.slice(MEDIA_BASE.length);
                } else if (node.querySelectorAll) {
                  localize(node);
                }
              }
            }
          }).observe(document.documentElement, { childList: true, subtree: true });
        })();
      </script>
    )}
    <al-theme id="sl-theme" mode={theme} contrast="more">
      <script is:inline>
        // Persisted ink/paper preference (localStorage) wins over the
        // per-page default set above — runs before the theme host upgrades,
        // so there is no flash of the wrong mode.
        (function () {
          try {
            var stored = localStorage.getItem('sl-mode');
            if (stored === 'light' || stored === 'dark') {
              document.getElementById('sl-theme').setAttribute('mode', stored);
            }
          } catch (e) {
            /* localStorage unavailable (privacy mode, SSR preview) — page default stands. */
          }
        })();
      </script>
      <div class="sl-page">
        <Header />
        <main>
          <slot />
        </main>
        <Footer />
      </div>
    </al-theme>

    <script>
      // Ink/paper toggle — event-delegated so it works for any
      // `[data-sl-mode-toggle]` control the header renders (T3). Icon-only
      // (T9 round 2, matching v5's circular icon button) — the affordance
      // updates via the `label`/`title` a11y properties, not text content.
      function describeMode(next: string) {
        return next === 'dark' ? 'Switch to paper (light) mode' : 'Switch to ink (dark) mode';
      }

      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const trigger = target.closest<HTMLElement & { label?: string }>('[data-sl-mode-toggle]');
        if (!trigger) return;
        const themeHost = document.getElementById('sl-theme');
        if (!themeHost) return;
        const next = themeHost.getAttribute('mode') === 'dark' ? 'light' : 'dark';
        themeHost.setAttribute('mode', next);
        trigger.setAttribute('data-sl-mode', next);
        trigger.label = describeMode(next);
        trigger.setAttribute('title', describeMode(next));
        try {
          localStorage.setItem('sl-mode', next);
        } catch (e) {
          /* ignore */
        }
      });

      // Reflect the resolved (possibly localStorage-restored) mode onto the
      // toggle's label on first paint.
      const themeHost = document.getElementById('sl-theme');
      const toggle = document.querySelector<HTMLElement & { label?: string }>('[data-sl-mode-toggle]');
      if (themeHost && toggle) {
        const current = themeHost.getAttribute('mode') === 'dark' ? 'dark' : 'light';
        toggle.setAttribute('data-sl-mode', current);
        toggle.label = describeMode(current);
        toggle.setAttribute('title', describeMode(current));
      }
    </script>

    <script>
      import '@southleft/al-web-components/components/avatar';
      import '@southleft/al-web-components/components/badge';
      import '@southleft/al-web-components/components/breadcrumbs-item';
      import '@southleft/al-web-components/components/breadcrumbs';
      import '@southleft/al-web-components/components/button';
      /*
       * THE BRAND IMPLEMENTATION OF `al-card` — same rule as the header and
       * footer below. Southleft's card is a SUPERSET of Altitude's: every
       * region and property the base card has, plus the `service` and `tool`
       * variants this site's homepage is built from. Importing the base module
       * alongside it would register whichever evaluated first and the other's
       * markup would never upgrade.
       */
      import '@southleft/sl-web-components/components/card';
      import '@southleft/al-web-components/components/chip';
      /*
       * The closing CTA band. Southleft's own section component, adopted here so
       * the site stops hand-rolling markup the brand package already owns (and
       * the docs already document at /docs/southleft/components/cta-band).
       */
      import '@southleft/sl-web-components/components/cta-band';
      /* The interior-page title band (components/PageHero.astro). */
      import '@southleft/sl-web-components/components/page-hero';
      /* The numbered section rule + kicker + heading (components/SectionHeader.astro). */
      import '@southleft/sl-web-components/components/section-header';
      /* The client logo band. The app restates its knock-back filter per mode
       * (styles/layout.css) — the component's default is the dark treatment and a
       * shadow root cannot see the mode attribute on an ancestor. */
      import '@southleft/sl-web-components/components/logo-wall';
      /* The display-type belt (components/Marquee.astro). */
      import '@southleft/sl-web-components/components/marquee';
      import '@southleft/al-web-components/components/divider';
      /*
       * THE BRAND IMPLEMENTATIONS OF `al-footer` AND `al-header`.
       *
       * Same tag as the base library's, different component: Southleft's header
       * is a full navigation bar and its footer a three-column masthead, where
       * Altitude's are bare landmarks. The design system declares that override
       * in `.altitude/ds-projects.json` (brandLibrary.supersedes), and THIS is
       * where it takes effect — `customElements.define` is first-come and
       * cannot be undone, so the override is expressed by importing one module
       * instead of the other rather than by any runtime negotiation.
       *
       * Do not add the base `@southleft/al-web-components/components/header`
       * back alongside this. Whichever evaluated first would win, and the
       * loser's markup would render into an element that never upgrades.
       */
      import '@southleft/sl-web-components/components/footer';
      import '@southleft/sl-web-components/components/header';
      import '@southleft/al-web-components/components/heading';
      import '@southleft/al-web-components/components/link';
      import '@southleft/al-web-components/components/list-item';
      import '@southleft/al-web-components/components/list';
      import '@southleft/al-web-components/components/logo';
      import '@southleft/al-web-components/components/layout';
      import '@southleft/al-web-components/components/stat';
      import '@southleft/al-web-components/components/tab-panel';
      import '@southleft/al-web-components/components/tab';
      import '@southleft/al-web-components/components/tabs';
      import '@southleft/al-web-components/components/testimonial';
      import '@southleft/al-web-components/components/text-block';
      import '@southleft/al-web-components/components/theme';
    </script>
  </body>
</html>
