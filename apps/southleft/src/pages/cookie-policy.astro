// Cookie Policy — spec 2026-08-20-southleft-example-app, T10.
// Legal text migrated VERBATIM from southleft-v5's src/pages/cookie-policy.astro
// (itself extracted verbatim from the live WordPress site) — do not rewrite,
// only relative-link touch-ups.
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';

const policyHtml = `
<p><em>Last updated: July 22, 2026</em></p>
<h2>Introduction</h2>
<p>At Southleft ("we," "us," or "our"), we use cookies to enhance the user experience on our website, <a href="/">https://southleft.com</a>. This Cookie Policy explains what cookies are, how we use them, and how you can manage them. By continuing to use our website, you consent to our use of cookies in accordance with this policy.</p>
<h2>What Are Cookies?</h2>
<p>Cookies are small text files stored on your device when you visit a website. They help websites remember information about your visit, like your preferred language and other settings, making your next visit easier and the site more useful.</p>
<h2>How We Use Cookies</h2>
<ol>
<li><strong>Analytics Cookies:</strong> We use Google Analytics cookies to understand how our website is being used and to help us make improvements.</li>
<li><strong>Authentication Cookies:</strong> If you leave a comment or log into our site, we may set cookies to save your login information and screen display choices.</li>
<li><strong>Embedded Content Cookies:</strong> Some pages on our site may include embedded content, and these sites may set their own cookies.</li>
<li><strong>Temporary Cookies:</strong> Temporary cookies are used to determine if your browser accepts cookies and are discarded when you close your browser.</li>
</ol>
<h2>Your Choices</h2>
<p>You have the right to accept or reject cookies. Most web browsers automatically accept cookies, but you can usually modify your browser setting to decline cookies if you prefer. Please note that opting out of certain cookies may affect the functionality of our website.</p>
<p>Here's how you can manage cookies in different browsers:</p>
<ul>
<li><strong>Google Chrome:</strong> <a href="https://support.google.com/chrome/answer/95647">Instructions</a></li>
<li><strong>Mozilla Firefox:</strong> <a href="https://support.mozilla.org/en-US/kb/enable-and-disable-cookies-website-preferences">Instructions</a></li>
<li><strong>Apple Safari:</strong> <a href="https://support.apple.com/guide/safari/manage-cookies-and-website-data-sfri11471/mac">Instructions</a></li>
<li><strong>Microsoft Edge:</strong> <a href="https://support.microsoft.com/en-us/microsoft-edge/delete-cookies-in-microsoft-edge-63947406-40ac-c3b8-57b9-2a946a29ae09">Instructions</a></li>
</ul>
<h2>Contact Us</h2>
<p>If you have any questions or concerns regarding this Cookie Policy, please contact us at <a href="mailto:info@southleft.com">info@southleft.com</a>.</p>
`;
---

<Base title="Cookie Policy" description="What cookies are, how Southleft uses them on this website, and how you can manage them in your browser." theme="light">
  <div class="sl-section--tight">
    <PageHero label="legal" heading="Cookie Policy" />
  </div>
  <div class="sl-container sl-section sl-container--prose">
    <al-text-block set:html={policyHtml} />
  </div>
</Base>
