---
// Tools — spec 2026-08-20-southleft-example-app, T4-1 (IA/placeholder) + T7
// (Figma-sync + token showcase, this pass).
//
// Four sections beyond the existing open-source tool grid:
//   (a) live token tree — from THIS app's own `/tokens.json` contract
//       (@southleft/al-web-components/tokens.json, re-served verbatim by
//       src/pages/tokens.json.ts) — grouped by tier, searchable.
//   (b) tier <-> Figma collection mapping table, sourced from
//       .altitude/FIGMA-SYNC.md — kept accurate to that doc.
//   (c) a drift-check demo: scripts/check-figma-drift.mjs run for REAL at
//       BUILD time against a committed sample export
//       (src/fixtures/figma-export.sample.json), not a simulated report.
//   (d) the Altitude MCP server's tool list, from libs/altitude-mcp/README.md.
import { execFileSync } from 'node:child_process';
import { resolve } from 'node:path';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CTABand from '../../components/CTABand.astro';
import tokens from '@southleft/al-web-components/tokens.json';

const oss = [
  { name: 'figma-console-mcp', href: 'https://github.com/southleft/figma-console-mcp', desc: 'AI-powered design system management inside Figma.' },
  { name: 'story-ui', href: 'https://github.com/southleft/story-ui', desc: 'AI layout generation for Storybook via MCP.' },
  { name: 'figmalint', href: 'https://github.com/southleft/figmalint', desc: 'Design linting for developer-ready Figma files.' },
  { name: 'design-systems-mcp', href: 'https://github.com/southleft/design-systems-mcp', desc: 'A design systems knowledge base your AI can query.' },
];

// (a) — re-groups the SAME flat map `/tokens.json` serves. `al-theme-*` is
// the semantic/composed surface (tier-2 role tokens plus tier-3 brand+mode
// resolution baked in by the build); everything else is a tier-1 primitive.
const tokenEntries = Object.entries(tokens as Record<string, string>).sort(([a], [b]) => a.localeCompare(b));
const primitiveTokens = tokenEntries.filter(([name]) => !name.startsWith('al-theme-'));
const semanticTokens = tokenEntries.filter(([name]) => name.startsWith('al-theme-'));

// (c) — runs the REAL gate, at build time, against a committed fixture.
// Never a hand-typed/simulated report: what's on this page is exactly what
// `node scripts/check-figma-drift.mjs <fixture>` prints.
// NOT `import.meta.url`/`__dirname` — Astro's build bundles this frontmatter
// into a chunk under an internal `.astro/` cache directory, so a path
// resolved from the SOURCE file's own location is wrong once bundled (it is
// only correct in dev, where nothing gets rebundled). `process.cwd()` is
// stable in both: `astro dev`/`astro build` are always invoked with this
// package (`apps/southleft`) as the working directory (`pnpm --filter
// al-app-southleft build`, this package's own `start`/`build` scripts).
const APP_ROOT = process.cwd();
const REPO_ROOT = resolve(APP_ROOT, '../..'); // apps/southleft -> apps -> root
const DRIFT_SCRIPT = resolve(REPO_ROOT, 'scripts/check-figma-drift.mjs');
const DRIFT_FIXTURE = resolve(APP_ROOT, 'src/fixtures/figma-export.sample.json');

let driftReport = '';
let driftExitCode = 0;
let driftRunError: string | null = null;
try {
  driftReport = execFileSync(process.execPath, [DRIFT_SCRIPT, DRIFT_FIXTURE], { encoding: 'utf8', cwd: REPO_ROOT });
} catch (err) {
  // check-figma-drift.mjs exits 1 when drift is found (expected — this
  // fixture has two deliberate drifts) or 2 on a usage error.
  // execFileSync throws on any non-zero exit; stdout survives on the error.
  const e = err as { stdout?: string; status?: number; message?: string };
  driftReport = e.stdout ?? '';
  driftExitCode = typeof e.status === 'number' ? e.status : 1;
  if (!driftReport) driftRunError = e.message ?? 'check-figma-drift.mjs failed to run';
}
---

<Base title="Tools" description="Open-source AI tooling for design systems, built and shipped by Southleft — plus Altitude, our own design system and AI testbed.">
  <div class="sl-section--tight">
    <PageHero
      label="tools"
      heading="We publish our homework"
      dek="If we recommend a workflow, it’s because we’ve already built and shipped it. Open-source, in production, used by real teams."
    />
  </div>

  <div class="sl-container sl-section">
    <al-layout variant="grid" noCollapse>
      {oss.map((t) => (
        <div class="al-u-grid__item col:12 col:6@md col:3@lg">
          <al-card>
            <div slot="header"><al-heading tagName="h3" variant="sm" isBold={true}><a href={t.href} target="_blank" rel="noopener">{t.name}</a></al-heading></div>
            <al-text-block>{t.desc}</al-text-block>
          </al-card>
        </div>
      ))}
    </al-layout>
  </div>

  <!-- (a) Live token tree -->
  <div class="sl-container sl-section" data-section-id="tokens">
    <div style="margin-block-end: var(--al-theme-space-xl);">
      <al-layout gap="sm">
        <al-heading tagName="h2" variant="lg" isBold={true}>Altitude — live token tree</al-heading>
        <!-- al-text-block's shadow root is `display: flex; flex-direction:
             column` over its DEFAULT-SLOT children — bare text + inline
             elements as separate top-level slotted nodes each become their
             own flex item (blockified, stacked), breaking prose into one
             line per fragment. A single <p> wrapper keeps the sentence as
             ONE slotted child, so everything inside it flows via normal
             inline layout instead. (T7/T8 — real app-markup bug, applies
             everywhere this page mixes text with inline links/code.) -->
        <al-text-block maxWidth="sm">
          <p class="sl-prose">
            The exact contract served at <al-link href="/tokens.json">/tokens.json</al-link> —
            Altitude's own shipped token surface, re-served verbatim, never a copy.
            {tokenEntries.length} tokens: {primitiveTokens.length} primitive (tier-1),{' '}
            {semanticTokens.length} semantic + composed (tier-2/tier-3).
          </p>
        </al-text-block>
      </al-layout>
    </div>

    <al-input
      id="sl-token-search"
      label="Search tokens"
      placeholder="e.g. color, radius, shadow, duration"
      class="sl-token-search"
    ></al-input>

    <div class="sl-token-columns">
      <div>
        <al-heading tagName="h3" variant="sm" isBold={true}>Primitive — tier-1</al-heading>
        <ul class="sl-token-list" data-token-group tabindex="0" aria-label="Primitive tier-1 tokens, scrollable">
          {primitiveTokens.map(([name, value]) => (
            <li class="sl-token-row" data-token-name={name.toLowerCase()}>
              {name.includes('color') && (
                <span class="sl-token-swatch" style={`background-color:${value}`} aria-hidden="true"></span>
              )}
              <code class="sl-token-name">--{name}</code>
              <span class="sl-token-value">{value}</span>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <al-heading tagName="h3" variant="sm" isBold={true}>Semantic + composed — tier-2/tier-3</al-heading>
        <ul class="sl-token-list" data-token-group tabindex="0" aria-label="Semantic and composed tier-2/tier-3 tokens, scrollable">
          {semanticTokens.map(([name, value]) => (
            <li class="sl-token-row" data-token-name={name.toLowerCase()}>
              {name.includes('color') && (
                <span class="sl-token-swatch" style={`background-color:${value}`} aria-hidden="true"></span>
              )}
              <code class="sl-token-name">--{name}</code>
              <span class="sl-token-value">{value}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <p id="sl-token-search-empty" class="al-u-theme-typography-body-xs" hidden>No tokens match your search.</p>
  </div>

  <!-- (b) Tier <-> Figma collection mapping -->
  <div class="sl-container sl-section" data-section-id="figma-mapping">
    <div style="margin-block-end: var(--al-theme-space-xl);">
      <al-layout gap="sm">
        <al-heading tagName="h2" variant="lg" isBold={true}>Figma ↔ Altitude token sync</al-heading>
        <al-text-block maxWidth="sm">
          <p class="sl-prose">
            Agent-mediated, not scheduled — a human (or an agent acting for one) initiates every
            sync via the <a href="https://github.com/southleft/figma-console-mcp" target="_blank" rel="noopener">Figma Console MCP</a>.
            Full loop and fidelity rules: <code>.altitude/FIGMA-SYNC.md</code>.
          </p>
        </al-text-block>
      </al-layout>
    </div>

    <al-table caption="Figma collection to Altitude token source mapping">
      <table>
        <thead>
          <tr>
            <th scope="col">Figma collection</th>
            <th scope="col">Modes</th>
            <th scope="col">Altitude source</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Primitive</td>
            <td>Default</td>
            <td><code>tokens/tier-1/*.json</code></td>
          </tr>
          <tr>
            <td>Semantic</td>
            <td>Default</td>
            <td><code>tokens/tier-2/*.json</code> (borders, spacing, shadows, typography, …)</td>
          </tr>
          <tr>
            <td>Color Scheme</td>
            <td>Light, Dark</td>
            <td><code>tokens/tier-2/theme/{'{'}light,dark{'}'}/</code></td>
          </tr>
          <tr>
            <td>Brand</td>
            <td>Altitude, Southleft</td>
            <td><code>tokens/tier-2/brand/&lt;brand&gt;/</code> (sparse overrides)</td>
          </tr>
          <tr>
            <td>Composed (tier 3)</td>
            <td>Light, Dark</td>
            <td><code>tokens/tier-3/theme/{'{'}light,dark{'}'}/</code></td>
          </tr>
        </tbody>
      </table>
    </al-table>

    <al-text-block maxWidth="sm" style="margin-block-start: var(--al-theme-space-lg);">
      <p class="sl-prose">
        <strong>The sync loop:</strong> read (<code>figma_export_tokens</code>, saved to
        <code>.altitude/figma-sync/last-export.json</code>, gitignored) → diff (
        <code>node scripts/check-figma-drift.mjs &lt;export&gt;</code>) → reconcile (edit
        <code>styles/tokens-dtcg/**</code> or push variables back, direction depends on which side
        moved) → verify (re-export, re-run the drift check, expect zero findings).
      </p>
    </al-text-block>
  </div>

  <!-- (c) Drift-check demo -->
  <div class="sl-container sl-section" data-section-id="drift-demo">
    <div style="margin-block-end: var(--al-theme-space-xl);">
      <al-layout gap="sm">
        <al-heading tagName="h2" variant="lg" isBold={true}>Drift-check demo</al-heading>
        <al-text-block maxWidth="sm">
          <p class="sl-prose">
            A demo of the deterministic gate — this is the REAL output of{' '}
            <code>scripts/check-figma-drift.mjs</code>, run at build time against a committed
            sample export (<code>src/fixtures/figma-export.sample.json</code>), not a simulated
            report. That fixture mirrors two real token groups
            (<code>tier-1/opacity.json</code>, <code>tier-1/borders.json</code>) with two
            deliberate drifts planted so both directions show up: <code>border.radius.24</code>{' '}
            exists in code but was left out of the sample export, and <code>border.radius.32</code>{' '}
            exists in the sample export but not in code. Every other finding below is genuine,
            real-world drift-check behavior for a small/partial sample file — see
            <code>.altitude/FIGMA-SYNC.md</code>'s "Dry-run playbook": a Figma file that doesn't
            yet cover the whole token tree reports everything it's missing, which is exactly what
            a first sync looks like.
          </p>
        </al-text-block>
      </al-layout>
    </div>

    <al-card>
      <div slot="header" class="sl-drift-demo-header">
        <al-heading tagName="h3" variant="sm" isBold={true}>check-figma-drift.mjs</al-heading>
        <al-chip variant={driftExitCode === 0 ? 'success' : 'warning'}>
          exit {driftExitCode}{driftExitCode === 0 ? ' — clean' : ' — drift found'}
        </al-chip>
      </div>
      {driftRunError ? (
        <al-text-block>Could not run the gate at build time: {driftRunError}</al-text-block>
      ) : (
        <pre class="sl-drift-report" tabindex="0" aria-label="check-figma-drift.mjs report, scrollable"><code>{driftReport}</code></pre>
      )}
    </al-card>
  </div>

  <!-- (d) Altitude MCP server -->
  <div class="sl-container sl-section" data-section-id="mcp">
    <div style="margin-block-end: var(--al-theme-space-xl);">
      <al-layout gap="sm">
        <al-heading tagName="h2" variant="lg" isBold={true}>The Altitude MCP server</al-heading>
        <al-text-block maxWidth="sm">
          <p class="sl-prose">
            A stdio <a href="https://modelcontextprotocol.io" target="_blank" rel="noopener">MCP</a>{' '}
            server exposing Altitude's already-generated token/component graph to AI agents. It
            reads generated artifacts that already exist elsewhere in the repo — never a second
            source of truth — and never calls an LLM itself. Registered in this repo's
            <code>.mcp.json</code> as <code>altitude</code>. Source: <code>libs/altitude-mcp/README.md</code>.
            Beyond the 8 tools below it also exposes <strong>resources</strong> (subscribable-by-URI
            pulls of the same generated artifacts, under an <code>altitude://</code> scheme) and{' '}
            <strong>prompts</strong> (reusable workflows — auditing Figma parity, drafting a brand
            theme, checking a snippet, scaffolding a component). Full intent → tool/resource/prompt →
            required filters → expected fields → common failure mode table, generated from a live
            handshake against the server: <code>libs/altitude-mcp/CAPABILITY-MATRIX.md</code>.
          </p>
        </al-text-block>
      </al-layout>
    </div>

    <al-layout variant="grid" noCollapse>
      {[
        { tool: 'altitude_list_components', reads: 'custom-elements.json + migration.json', desc: 'Lists components, filterable by name, with migration state.' },
        { tool: 'altitude_get_component', reads: 'CEM + component JSON Schema + story metadata', desc: 'Full detail for one component — attributes, slots, events, schema, Storybook docs URL.' },
        { tool: 'altitude_validate', reads: 'cli/validate.mjs --json', desc: 'Validates markup or a file against Altitude usage rules.' },
        { tool: 'altitude_get_tokens', reads: 'dist/css/{tokens,aliases}.json + tokens-dtcg/**', desc: 'Queries the resolved token set, or a specific tier/brand/mode.' },
        { tool: 'altitude_search_icons', reads: 'icon catalog', desc: 'Finds an icon by name, tag, or category, with an import snippet.' },
        { tool: 'altitude_generate_theme', reads: 'dist/theme-engine — the SAME deterministic OKLCH engine this page uses', desc: 'Generates a WCAG-AA theme from a prompt or explicit direction — never calls an LLM.' },
        { tool: 'altitude_check_parity', reads: 'parity manifest + live source hashing', desc: 'Figma ↔ code parity per component, per design system — each drifted entry carries a ready-to-run AI fix prompt.' },
        { tool: 'altitude_list_ds_projects', reads: 'ds-projects.json', desc: 'Every design system this repo drives — Figma file, brand, docs base, parity manifest.' },
      ].map((t) => (
        <div class="al-u-grid__item col:12 col:6@md col:4@lg">
          <al-card style="height:100%; box-sizing:border-box;">
            <div slot="header"><al-heading tagName="h4" variant="sm" isBold={true}><code>{t.tool}</code></al-heading></div>
            <al-text-block>
              <p>{t.desc}</p>
              <p class="al-u-theme-typography-body-xs">Reads: {t.reads}</p>
            </al-text-block>
          </al-card>
        </div>
      ))}
    </al-layout>

    <div style="margin-block-start: var(--al-theme-space-xl);">
      <al-heading tagName="h3" variant="sm" isBold={true}>Prompts</al-heading>
    </div>
    <al-layout variant="grid" noCollapse style="margin-block-start: var(--al-theme-space-md);">
      {[
        { prompt: 'audit_component_parity', desc: 'Draft a Figma ↔ code reconciliation plan for one component, grounded in the live parity engine and the altitude-figma-sync skill.' },
        { prompt: 'generate_brand_theme', desc: 'Draft an altitude_generate_theme call from a short prompt/mode/personality, and how to apply the result.' },
        { prompt: 'check_snippet_convention', desc: 'Draft an altitude_validate call for a proposed snippet, plus the code → fix self-heal loop.' },
        { prompt: 'scaffold_component', desc: 'Pre-flight a proposed component name against the layout-primitive gate, then walk the authoring checklist.' },
      ].map((p) => (
        <div class="al-u-grid__item col:12 col:6@md col:3@lg">
          <al-card style="height:100%; box-sizing:border-box;">
            <div slot="header"><al-heading tagName="h4" variant="sm" isBold={true}><code>{p.prompt}</code></al-heading></div>
            <al-text-block><p>{p.desc}</p></al-text-block>
          </al-card>
        </div>
      ))}
    </al-layout>
  </div>

      <CTABand />
</Base>

<script>
  import '@southleft/al-web-components/components/table';
  import '@southleft/al-web-components/components/input';

  const search = document.getElementById('sl-token-search') as (HTMLElement & { value?: string }) | null;
  const rows = Array.from(document.querySelectorAll<HTMLElement>('.sl-token-row'));
  const empty = document.getElementById('sl-token-search-empty');

  function filter(query: string): void {
    const q = query.trim().toLowerCase();
    let visible = 0;
    for (const row of rows) {
      const match = q === '' || (row.dataset.tokenName ?? '').includes(q);
      row.hidden = !match;
      if (match) visible += 1;
    }
    if (empty) empty.hidden = visible > 0;
  }

  search?.addEventListener('input', () => filter(search.value ?? ''));
</script>
