  { file: 'petsmart.webp', name: 'PetSmart' },
  { file: 'toast.webp', name: 'Toast' },
  { file: 'caterpillar.webp', name: 'Caterpillar' },
  { file: 'cigna-health.webp', name: 'Cigna Health' },
  { file: 'conde-nast.webp', name: 'Condé Nast' },
