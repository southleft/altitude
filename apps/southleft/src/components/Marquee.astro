---
/** Endless belt of outline display type. Decorative reinforcement of the
 *  message — pauses on hover, static under reduced motion.
 *
 *  Now `<al-marquee>` from @southleft/sl-web-components (docs:
 *  /docs/southleft/components/marquee). The component owns the belt: it reads
 *  each slotted element's text on `slotchange`, renders TWO copies inside its
 *  shadow root so the -50% translate loops seamlessly, and hides the originals.
 *  The ~60-line scoped style block that used to live here is gone with it.
 *
 *  TWO THINGS THIS CALL SITE HAS TO DO, both consequences of the component
 *  reading its slot as DATA rather than rendering it:
 *
 *  1. `aria-hidden` moves to the HOST. The component puts it on its shadow
 *     wrapper, which leaves the slotted spans exposed to assistive tech before
 *     (and technically after) upgrade. This band is decorative, so the host is
 *     the right place for it.
 *  2. `hidden until upgrade`. `::slotted(*) { display: none }` is shadow CSS and
 *     does not apply until the element upgrades — so without this the raw spans
 *     flash as unstyled inline body copy on every load, above the fold. The
 *     inline style is removed by the component's own `:host` rule taking over
 *     (`display: block`), and `:not(:defined)` scopes it to exactly that window.
 */
const items = [
  { t: 'Design Systems', v: undefined },
  { t: '×', v: 'solid' },
  { t: 'AI', v: undefined },
  { t: '— built by the people building the tools —', v: 'mono' },
  { t: 'Tokens', v: undefined },
  { t: '<S>', v: 'solid' },
  { t: 'Parity', v: undefined },
  { t: '// zero rogue divs', v: 'mono' },
];
---

<al-marquee aria-hidden="true">
  {items.map((i) => <span data-variant={i.v}>{i.t}</span>)}
</al-marquee>

<style is:global>
  /* See (2) above — closes the pre-upgrade flash of unstyled belt text. */
  al-marquee:not(:defined) {
    display: block;
    visibility: hidden;
    block-size: 10.125rem; /* the belt's rendered height, so nothing reflows on upgrade */
  }
</style>
