---
// Case-study card — spec 2026-08-20-southleft-example-app, T4.
//
// REBUILT ON `<al-card variant="work">` — the same move as ArticleCard.astro,
// and the same reasoning: the constraint that forced bespoke markup here was
// Altitude's card wrapping its image region in the card's own padding, which
// Southleft's card no longer does. `work` is the case-study cut of the media
// anatomy: a 16/10 media ratio, a two-line excerpt clamp, a tighter rhythm and
// the tag row.
//
// The heading is the CLIENT NAME, not the full case-study title. Client names
// are short (1-2 words: "PetSmart", "IBM"), so they do not overwrap at the `lg`
// step the component resolves for this variant — the opposite tradeoff from
// ArticleCard's long sentence titles.
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/url';

interface Props {
  project: CollectionEntry<'work'>;
}
const { project } = Astro.props;
const slug = project.id.replace(/\.md$/, '');
const href = withBase(`/projects/${slug}`);
const tags = (project.data.capabilities ?? []).slice(0, 3);
const showImage = project.data.hero && project.data.showHero;
---

<al-card
  variant="work"
  fill
  href={href}
  image={showImage ? withBase(project.data.hero) : undefined}
  fallback={showImage ? undefined : `<${project.data.client.slice(0, 1)}>`}
  heading={project.data.client}
  excerpt={project.data.oneLiner || undefined}
  footer-label="case study →"
>
  {tags.map((t) => <span slot="tags">{t}</span>)}
</al-card>
