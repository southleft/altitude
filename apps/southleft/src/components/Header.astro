---
// Sticky primary nav — spec 2026-08-22-southleft-example-1-to-1-parity, T4.
//
// REBUILT on `<al-header>` + `<al-layout>`. The previous revision was a plain
// semantic `<header>`, justified by a comment claiming `al-header`'s shadow
// DOM "forces its default/before/after slots into three EQUAL flex:1 thirds".
// That is no longer true and hasn't been since the header/footer arrangement
// removal (spec 2026-08-21-header-and-footer-arrangement-removal):
// `header.ts` now renders a SINGLE unnamed slot, and `header.scss` is a
// one-column grid that takes no position on horizontal distribution. So the
// component composes cleanly with an `<al-layout>` row and there is no reason
// left to hand-roll the landmark.
//
// Two things `al-header` could not express before this spec — the hairline
// under the bar and the backdrop blur — are now `--al-header-border-block-end`
// and `--al-header-backdrop-filter` (header.scss). They HAD to move into the
// component: `:host` is `display: contents`, so the shadow-root `<header>` is
// the only box, and no page-level rule can reach it.
//
// The page measure is `<al-layout variant="constrained">`, not a bespoke
// `.sl-header__bar` max-width. `--al-layout-measure: 79rem` (1264px) plus the
// reference's own `clamp(1.25rem, 4vw, 3rem)` gutter reproduces v5's
// `.container-sl` EXACTLY at every width: at 1440 the content column measures
// x=88 w=1264, which is what the reference measures. (v5's 1360px figure is
// its border-box INCLUDING padding; al-layout's `measure` is the content
// column, hence 1264 = 1360 − 2×48.)
//
// The nav pills, the two circular icon buttons and the mobile panel have no
// al-* equivalent — v5 hand-styles them too — so they stay app markup styled
// through src/styles/layout.css tokens.
import { NAV, CTA } from '../lib/site';
import { withBase } from '../lib/url';

// `Astro.url.pathname` includes the `/southleft` base (astro.config.mjs) in
// both dev and build — strip it before comparing against NAV's unprefixed
// hrefs, mirroring v5's own path-based `isActive`.
const BASE = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
const rawPath = Astro.url.pathname.startsWith(BASE) ? Astro.url.pathname.slice(BASE.length) : Astro.url.pathname;
const path = rawPath.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<al-header sticky class="sl-header" data-header>
  <al-layout variant="constrained" class="sl-measure">
    <!-- `justify="between"` with exactly TWO children — the wordmark, and one
         group holding nav + actions — is what pushes the right-hand cluster to
         the gutter. The previous revision used `margin-inline-start: auto` on
         nav and actions; that cannot work once those become `<al-layout>`s,
         because an al-layout host is `display: contents` and margins on such a
         box are dropped (its inner `.al-c-layout` div is the real flex item).
         Saying `justify="between"` states the intent directly instead. -->
    <al-layout direction="row" align="center" justify="between" gap="lg" class="sl-header__bar">
      <!-- `al-logo` renders its OWN `<a href>` (logo.ts) — wrapping it in a
           second anchor, as the previous revision did, nests one interactive
           element inside another (axe `nested-interactive`). The aria-label
           moves onto the component itself. -->
      <al-logo variant="southleft" href={withBase('/')} class="sl-header__logo" aria-label="Southleft home"></al-logo>

      <al-layout direction="row" align="center" gap="md">
        <nav class="sl-header__nav" aria-label="Primary">
          <al-layout direction="row" align="center" gap="xs">
            {NAV.map((item) => (
              <a
                href={withBase(item.href)}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'sl-header__nav-link al-u-theme-typography-body-sm',
                  isActive(item.href) && 'sl-header__nav-link--active',
                ]}
              >
                {item.label}
              </a>
            ))}
          </al-layout>
        </nav>

        <al-layout direction="row" align="center" gap="sm" class="sl-header__actions">
        <button
          type="button"
          id="theme-console-open"
          class="sl-header__icon-btn sl-header__icon-btn--accent-hover"
          aria-label="Open theme console — derive your own site theme"
          title="Derive your own theme"
          data-sl-ai-trigger
        >
          <!-- palette: three token dots + a brush stroke of a ring — copied
               verbatim from southleft-v5 src/components/Header.astro:48-53 -->
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M12 21a9 9 0 1 1 9-9c0 2.5-2 3-3.5 3H15a2 2 0 0 0-1.5 3.3c.6.7.2 1.7-.7 1.7Z"></path>
            <circle cx="8" cy="10.5" r="0.6" fill="currentColor"></circle>
            <circle cx="12" cy="7.5" r="0.6" fill="currentColor"></circle>
            <circle cx="16" cy="10.5" r="0.6" fill="currentColor"></circle>
          </svg>
        </button>
        <!-- Ink/paper toggle. v5 ships BOTH a sun and a moon and CSS-swaps
             them on the active theme (ThemeToggle.astro:36-40); the previous
             revision here had only a static sun, so the control never
             reflected its own state. Both icons are present now and the
             script below swaps them with the mode. -->
        <button
          type="button"
          class="sl-header__icon-btn"
          aria-label="Switch to paper (light) mode"
          title="Ink / paper"
          data-sl-mode-toggle
        >
          <svg data-sl-mode-icon="dark" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 3v2M12 19v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M3 12h2M19 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"></path>
          </svg>
          <svg data-sl-mode-icon="light" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" style="display:none">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
          </svg>
        </button>
        <span class="sl-header__cta">
          <al-button href={withBase(CTA.href)}>{CTA.label}</al-button>
        </span>
        <button
          type="button"
          class="sl-header__icon-btn sl-header__menu-btn"
          aria-label="Menu"
          aria-expanded="false"
          aria-controls="mobile-nav"
          data-menu-button
        >
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M3 6h18M3 12h18M3 18h18" class="icon-open"></path>
            <path d="M6 6l12 12M18 6L6 18" class="icon-close" style="display:none"></path>
          </svg>
        </button>
        </al-layout>
      </al-layout>
    </al-layout>
  </al-layout>

  <nav id="mobile-nav" class="sl-header__mobile-nav" aria-label="Primary mobile" hidden>
    <al-layout variant="constrained" class="sl-measure">
      <al-layout gap="xs" class="sl-header__mobile-nav-inner">
        {NAV.map((item, i) => (
          <a href={withBase(item.href)} class="sl-header__mobile-nav-link al-u-theme-typography-body-md">
            <span>{item.label}</span>
            <span class="sl-header__mobile-nav-index al-u-theme-typography-body-xs">0{i + 1}</span>
          </a>
        ))}
        <div class="sl-header__mobile-cta">
          <al-button href={withBase(CTA.href)} fullWidth>{CTA.label}</al-button>
        </div>
      </al-layout>
    </al-layout>
  </nav>
</al-header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelector('[data-sl-ai-trigger]')?.addEventListener('click', () => {
      // AIDirectionPanel (home page only) still owns the actual `al-drawer`
      // trigger — `.sl-ai-fab` (visually hidden now the header icon is the
      // real entry point, see layout.css) — so proxy-click it rather than
      // reimplementing al-drawer's own open/focus-management logic. A no-op
      // on pages without the panel is the correct degrade.
      const fab = document.querySelector<HTMLElement>('.sl-ai-fab');
      fab?.click();
    });

    // Keep the mode button's icon and label honest about the CURRENT mode.
    // `<al-theme mode>` is the source of truth (Base.astro), not a class on
    // <html>, so read it back rather than tracking a local boolean that can
    // drift from a mode set anywhere else.
    const modeBtn = document.querySelector<HTMLElement>('[data-sl-mode-toggle]');
    const themeEl = document.getElementById('sl-theme');
    const syncModeIcon = () => {
      if (!modeBtn || !themeEl) return;
      const isLight = themeEl.getAttribute('mode') === 'light';
      modeBtn.querySelector<SVGElement>('[data-sl-mode-icon="dark"]')?.style.setProperty('display', isLight ? 'none' : '');
      modeBtn.querySelector<SVGElement>('[data-sl-mode-icon="light"]')?.style.setProperty('display', isLight ? '' : 'none');
      const next = isLight ? 'ink (dark)' : 'paper (light)';
      modeBtn.setAttribute('aria-label', `Switch to ${next} mode`);
    };
    syncModeIcon();
    if (themeEl) new MutationObserver(syncModeIcon).observe(themeEl, { attributeFilter: ['mode'] });

    const menuBtn = document.querySelector<HTMLElement>('[data-menu-button]');
    const mobileNav = document.getElementById('mobile-nav');
    menuBtn?.addEventListener('click', () => {
      const willOpen = mobileNav?.hasAttribute('hidden');
      if (willOpen) {
        mobileNav?.removeAttribute('hidden');
      } else {
        mobileNav?.setAttribute('hidden', '');
      }
      menuBtn.setAttribute('aria-expanded', String(!!willOpen));
      const iconOpen = menuBtn.querySelector<SVGPathElement>('.icon-open');
      const iconClose = menuBtn.querySelector<SVGPathElement>('.icon-close');
      if (iconOpen && iconClose) {
        iconOpen.style.display = willOpen ? 'none' : '';
        iconClose.style.display = willOpen ? '' : 'none';
      }
    });
  });
</script>
