---
// Closing CTA band — spec 2026-08-20-southleft-example-app, T3/T4-1, T9
// round 2 (real copy defaults), REBUILT T12 audit-2 round (F): v5's real
// CTABand.astro is NOT `<al-hero>` — it has its own grid-texture
// background, a `<cta>` kicker, `py-24/md:py-32` padding, and a centered
// `.text-h1`/`.text-lead` stack (`al-hero`'s centered layout omits the
// texture and kicker, and under-pads relative to v5 — same rationale as
// the header/hero/media-card rebuilds).
import { CTA } from '../lib/site';
import { withBase } from '../lib/url';

interface Props {
  heading?: string;
  dek?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}
const {
  heading = 'Is your design system AI-ready?',
  dek = 'A 30-minute discovery call is the fastest way to find out where your leverage is.',
  secondaryLabel = 'Ask about a workshop',
  secondaryHref = '/services/workshops-training',
} = Astro.props;
---

<div class="sl-cta-band">
  <div class="sl-hero__texture" aria-hidden="true"></div>
  <div class="sl-container sl-cta-band__inner">
    <p class="sl-kicker sl-kicker--accent">&lt;cta&gt;</p>
    {/* T12 audit-3 (height closure) — `display-md`, scoped to the
        `southleft` brand, resolves to 72px/72px line-height — an exact
        match for v5's `.text-h1` (72px/73.44px) here. (An isolated,
        unscoped measurement outside `<al-theme>` misleadingly read 36px
        for this variant and 48px for `display-lg`; scoped, `display-lg`
        is actually ~112px, hero scale — confirmed live before reverting
        an earlier wrong bump to it.) */}
    <al-heading tagName="h2" variant="display-md" isBold={true} class="sl-cta-band__heading">{heading}</al-heading>
    <p class="sl-cta-band__dek">{dek}</p>
    <div style="margin-block-start: var(--al-theme-space-xl);">
      <al-layout direction="row" wrap gap="md" align="center" justify="center">
        <al-button href={withBase(CTA.href)}>{CTA.label}</al-button>
        <al-button variant="tertiary" href={secondaryHref.startsWith('http') ? secondaryHref : withBase(secondaryHref)}>{secondaryLabel}</al-button>
      </al-layout>
    </div>
  </div>
</div>
