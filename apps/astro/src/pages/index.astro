                </div>
                <al-heading variant="sm" tagName="h3"><a href="#">UX Designer</a></al-heading>
                <div class="al-u-gap-xs al-u-gap--row"><al-icon-pin></al-icon-pin><p>New Orleans, LA</p></div>
