{
  "name": "@southleft/altitude",
  "description": "Design system created by Southleft.com",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "react": "19.2.7",
      "react-dom": "19.2.7"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "@swc/core"
    ]
  },
  "scripts": {
    "build": "pnpm --filter al-web-components build && pnpm --filter al-react build",
    "build:storybook-web-components": "pnpm --filter al-web-components build:storybook --output-dir ../../dist/storybook/web-components",
    "build:storybook-react": "pnpm --filter al-react build:storybook --output-dir ../../dist/storybook/react",
    "build:app-angular": "pnpm --filter al-app-angular build --output-path ../../dist/angular --base-href /angular/browser/",
    "build:app-react": "pnpm --filter al-app-react build --base=/react --outDir ../../dist/react",
    "build:app-svelte": "pnpm --filter al-app-svelte build --base=/svelte --outDir ../../dist/svelte",
    "build:app-web-components": "pnpm --filter al-app-web-components build",
    "build:app-mfe": "pnpm --filter al-app-mfe build",
    "build:app-ssr": "pnpm --filter al-app-ssr build",
    "build:app-astro": "pnpm --filter al-app-astro build",
    "build:app-southleft": "pnpm --filter al-app-southleft build",
    "build:app-docs": "pnpm --filter al-app-docs build",
    "build:app-home": "pnpm --filter al-app-home build",
    "build:fixtures": "pnpm run build:app-web-components && pnpm run build:app-react && pnpm run build:app-mfe && pnpm run build:app-ssr",
    "build:all": "pnpm run build && pnpm run build:storybook-web-components && pnpm run build:storybook-react && pnpm run build:app-angular && pnpm run build:app-react && pnpm run build:app-svelte && pnpm run build:app-astro && pnpm run build:app-southleft && pnpm run build:app-docs && pnpm run copy:components && pnpm run build:app-home",
    "copy:components": "cp -r ./libs/al-web-components/dist ./dist/al-web-components",
    "dev:index": "npx serve ./dist",
    "parity:seed": "node scripts/figma-parity/seed-manifest.mjs",
    "parity:synced": "node scripts/figma-parity/mark-synced.mjs",
    "parity:refresh": "node scripts/figma-parity/refresh-figma-digests.mjs",
    "parity:projects": "node scripts/figma-parity/list-projects.mjs",
    "parity:seed:sl": "node scripts/figma-parity/seed-manifest.mjs --project southleft",
    "parity:synced:sl": "node scripts/figma-parity/mark-synced.mjs --project southleft",
    "parity:refresh:sl": "node scripts/figma-parity/refresh-figma-digests.mjs --project southleft",
    "gate:docs": "pnpm --filter al-app-docs check:coverage",
    "gate:migration": "node scripts/check-migration-gate.js",
    "gate:baselines": "node scripts/check-baselines-gate.js",
    "gate:self-test": "bash scripts/__tests__/gate-self-test.sh",
    "check:ds-projects": "node scripts/check-ds-projects.mjs",
    "check:sl-scope": "node scripts/check-sl-scope.mjs",
    "check:exports": "node scripts/check-exports-map.js",
    "check:changesets": "node scripts/check-changesets-config.js",
    "check:jsdoc": "node scripts/check-jsdoc-dialect.js",
    "test:brands": "node scripts/check-brand-distinctiveness.js",
    "brands:compare": "node scripts/build-brand-compare.mjs",
    "test:scoped-theming": "node scripts/check-scoped-theming.mjs",
    "test:preset-parity": "node scripts/check-preset-parity.mjs",
    "baselines:tokens": "node scripts/capture-token-baseline.js",
    "baselines:bundle": "node scripts/capture-bundle-baseline.js",
    "baselines:vrt": "playwright test --update-snapshots",
    "baselines:capture": "pnpm run build && pnpm --filter al-app-web-components build && pnpm run baselines:tokens && pnpm run baselines:bundle && pnpm run baselines:vrt",
    "test:vrt": "playwright test",
    "release": "pnpm run build && changeset publish",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:publishable": "node scripts/check-publishable.mjs",
    "check:audit": "node scripts/check-audit.mjs",
    "check:token-usage": "node scripts/check-token-usage.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@eslint/js": "^9",
    "@playwright/test": "^1.42.0",
    "@storybook/addon-a11y": "^10.4",
    "@storybook/test-runner": "^0.24",
    "ajv": "^8",
    "axe-core": "^4.10",
    "eslint": "^9",
    "globals": "^15",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "sass": "^1.101",
    "typescript": "^5.7",
    "typescript-eslint": "^8"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.15.0"
  }
}
