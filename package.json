{
  "name": "@southleft/altitude",
  "description": "Design system created by Southleft.com",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "react": "19.2.7",
      "react-dom": "19.2.7"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "@swc/core"
    ]
  },
  "scripts": {
    "build": "pnpm --filter al-web-components build && pnpm --filter al-react build",
    "build:storybook-web-components": "pnpm --filter al-web-components build:storybook --output-dir ../../dist/storybook/web-components",
    "build:storybook-react": "pnpm --filter al-react build:storybook --output-dir ../../dist/storybook/react",
    "build:app-angular": "pnpm --filter al-app-angular build --output-path ../../dist/angular --base-href /angular/browser/",
    "build:app-react": "pnpm --filter al-app-react build --base=/react --outDir ../../dist/react",
    "build:app-svelte": "pnpm --filter al-app-svelte build --base=/svelte --outDir ../../dist/svelte",
    "build:app-web-components": "pnpm --filter al-app-web-components build",
    "build:app-mfe": "pnpm --filter al-app-mfe build",
    "build:app-ssr": "pnpm --filter al-app-ssr build",
    "build:app-astro": "pnpm --filter al-app-astro build",
    "build:fixtures": "pnpm run build:app-web-components && pnpm run build:app-react && pnpm run build:app-mfe && pnpm run build:app-ssr",
    "build:all": "pnpm run build && pnpm run build:storybook-web-components && pnpm run build:storybook-react && pnpm run build:app-angular && pnpm run build:app-react && pnpm run build:app-svelte && pnpm run build:app-astro && pnpm run copy:components && pnpm run copy:index",
    "copy:components": "cp -r ./libs/al-web-components/dist ./dist/al-web-components",
    "copy:index": "cp ./index.html ./dist/index.html",
    "dev:index": "npx serve ./dist",
    "gate:migration": "node scripts/check-migration-gate.js",
    "gate:baselines": "node scripts/check-baselines-gate.js",
    "gate:self-test": "bash scripts/__tests__/gate-self-test.sh",
    "baselines:tokens": "node scripts/capture-token-baseline.js",
    "baselines:bundle": "node scripts/capture-bundle-baseline.js",
    "baselines:vrt": "playwright test --update-snapshots",
    "baselines:capture": "pnpm run build && pnpm --filter al-app-web-components build && pnpm run baselines:tokens && pnpm run baselines:bundle && pnpm run baselines:vrt",
    "test:vrt": "playwright test",
    "release": "pnpm run build && changeset publish",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@eslint/js": "^9",
    "@playwright/test": "^1.42.0",
    "@storybook/addon-a11y": "^10.4",
    "@storybook/test-runner": "^0.24",
    "ajv": "^8",
    "axe-core": "^4.10",
    "eslint": "^9",
    "globals": "^15",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "sass": "^1.101",
    "typescript": "^5.7",
    "typescript-eslint": "^8"
  }
}
